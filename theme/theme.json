{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1400px"
    },
    "color": {
      "palette": [
        {
          "slug": "primary",
          "color": "#0f172a",
          "name": "Navy Blue"
        },
        {
          "slug": "secondary",
          "color": "#475569",
          "name": "Slate Gray"
        },
        {
          "slug": "accent",
          "color": "#d97706",
          "name": "Amber Gold"
        },
        {
          "slug": "base",
          "color": "#ffffff",
          "name": "White"
        },
        {
          "slug": "background",
          "color": "#f8fafc",
          "name": "Light Blue Gray"
        }
      ],
      "gradients": [],
      "custom": true,
      "customGradient": true,
      "defaultGradients": false,
      "defaultPalette": false,
      "link": true
    },
    "typography": {
      "customFontSize": true,
      "fontFamilies": [
        {
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif",
          "name": "System Sans-serif",
          "slug": "system-font"
        }
      ],
      "fontSizes": [
        {
          "size": "0.875rem",
          "name": "Small",
          "slug": "small"
        },
        {
          "size": "1rem",
          "name": "Normal",
          "slug": "normal"
        },
        {
          "size": "1.25rem",
          "name": "Medium",
          "slug": "medium"
        },
        {
          "size": "1.75rem",
          "name": "Large",
          "slug": "large"
        },
        {
          "size": "2.5rem",
          "name": "Extra Large",
          "slug": "huge"
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "blockGap": true,
      "margin": true,
      "padding": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--primary)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--accent)"
          }
        }
      },
      "button": {
        "color": {
          "text": "var(--wp--preset--color--base)",
          "background": "var(--wp--preset--color--primary)"
        },
        "border": {
          "radius": "4px"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--accent)"
          }
        }
      }
    }
  }
}
