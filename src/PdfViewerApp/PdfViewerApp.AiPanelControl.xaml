<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PdfViewerApp.AiPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <UserControl.Resources>
    <Style x:Key="QuickPromptBtn" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="Foreground" Value="#CBD5E1" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="FrameworkElement.Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#334155" />
                <Setter Property="Foreground" Value="#F8FAFC" />
                <Setter Property="BorderBrush" Value="#475569" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#0F172A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Border Margin="0,5,5,5" Background="#111827" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="12">
    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel LastChildFill="False">
        <TextBlock Text="AI Snapshot" FontWeight="Black" FontSize="16" Foreground="#38BDF8" DockPanel.Dock="Left">
          <UIElement.Effect>
            <DropShadowEffect Color="#38BDF8" BlurRadius="6" Opacity="0.2" ShadowDepth="0" />
          </UIElement.Effect>
        </TextBlock>
        <Button Content="" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="28" Height="28" HorizontalAlignment="Right" DockPanel.Dock="Right" Style="{StaticResource AiActionBtn}" Click="Close_Click" />
      </DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,12" MaxHeight="450">
        <StackPanel>
          <TextBlock Text="CHẾ ĐỘ AI" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox Name="AiProviderModeComboBox" Style="{StaticResource ModernComboBox}" Width="120" Height="28" SelectedIndex="0" SelectionChanged="AnySettingsChanged">
              <ComboBoxItem Content="Auto" Tag="Auto" />
              <ComboBoxItem Content="Gemini" Tag="Gemini" />
              <ComboBoxItem Content="Local" Tag="Local" />
              <ComboBoxItem Content="Off" Tag="Off" />
            </ComboBox>
            <CheckBox Name="AiAllowOnlineCheckBox" Content="Cho phép online" IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#F8FAFC" FontSize="12" Checked="AnySettingsChanged" Unchecked="AnySettingsChanged" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox Name="AiEnableTelemetryCheckBox" Content="Gửi báo cáo lỗi" IsChecked="False" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="#F8FAFC" FontSize="12" Checked="AnySettingsChanged" Unchecked="AnySettingsChanged" />
            <CheckBox Name="AiEnableUpdateCheckCheckBox" Content="Tự động cập nhật" IsChecked="False" VerticalAlignment="Center" Foreground="#F8FAFC" FontSize="12" Checked="AnySettingsChanged" Unchecked="AnySettingsChanged" />
          </StackPanel>

          <TextBlock Text="GEMINI API KEY" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,4,0,4" />
          <TextBox Name="AiGeminiApiKeyTextBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,10" TextChanged="AnySettingsChanged" />

          <TextBlock Text="GEMINI MODEL (Đề xuất model tiết kiệm token)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4" />
          <ComboBox Name="AiGeminiModelComboBox" IsEditable="True" Style="{StaticResource ModernComboBox}" Margin="0,0,0,10" SelectionChanged="AnySettingsChanged">
            <ComboBoxItem Content="gemini-3.5-flash (Mới nhất 2026 - Siêu nhanh &amp; Tiết kiệm)" Tag="gemini-3.5-flash" />
            <ComboBoxItem Content="gemini-3.1-flash-lite (Siêu rẻ &amp; Phản hồi nhanh)" Tag="gemini-3.1-flash-lite" />
            <ComboBoxItem Content="gemini-2.5-flash (Thế hệ 2.5 ổn định)" Tag="gemini-2.5-flash" />
            <ComboBoxItem Content="gemini-3.5-pro (Trí tuệ cao nhất - Cho bản vẽ phức tạp)" Tag="gemini-3.5-pro" />
          </ComboBox>

          <TextBlock Text="MẪU GỢI Ý (CAD)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,4,0,4" />
          <WrapPanel Margin="0,0,0,8">
            <Button Content="🔍 Giải thích bản vẽ" Style="{StaticResource QuickPromptBtn}" Click="QuickPrompt_Click" Tag="Hãy phân tích vùng bản vẽ kỹ thuật này và giải thích chi tiết các thành phần chính có trong ảnh." />
            <Button Content="📏 Đọc kích thước" Style="{StaticResource QuickPromptBtn}" Click="QuickPrompt_Click" Tag="Hãy quét và đọc chính xác tất cả thông số kích thước, khoảng cách hoặc cao độ trong vùng bản vẽ này." />
            <Button Content="📐 Giải nghĩa ký hiệu" Style="{StaticResource QuickPromptBtn}" Click="QuickPrompt_Click" Tag="Liệt kê và giải thích ý nghĩa các ký hiệu kỹ thuật, ký hiệu vật liệu hoặc ký hiệu thiết bị trong ảnh." />
            <Button Content="🚧 Tìm điểm bất thường" Style="{StaticResource QuickPromptBtn}" Click="QuickPrompt_Click" Tag="Hãy kiểm tra kỹ vùng bản vẽ này để phát hiện nét vẽ chồng chéo, chữ bị đè, lỗi hiển thị hoặc điểm bất thường nào." />
          </WrapPanel>

          <TextBlock Text="CÂU HỎI / YÊU CẦU" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4" />
          <TextBox Name="AiPromptTextBox" Style="{StaticResource ModernTextBox}" MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True" Text="Hay doc va giai thich vung ban ve nay. Neu co text, trich xuat cac ghi chu quan trong." Margin="0,0,0,12" TextChanged="AnySettingsChanged" />

          <WrapPanel Margin="0,4,0,0">
            <Button Content="Lấy Gemini API" Style="{StaticResource AiActionBtn}" Margin="0,0,6,6" Click="OpenGeminiApiKey_Click" />
            <Button Content="Cài Local AI" Style="{StaticResource AiActionBtn}" Margin="0,0,6,6" Click="OpenOllamaDownload_Click" />
            <Button Content="Kiểm tra AI" Style="{StaticResource AiActionBtn}" Margin="0,0,6,6" Click="CheckAi_Click" />
            <Button Content="Lưu cấu hình" Style="{StaticResource AiActionBtn}" Margin="0,0,6,6" Click="SaveAiSettings_Click" />
          </WrapPanel>
        </StackPanel>
      </ScrollViewer>
      <Grid Grid.Row="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="KẾT QUẢ PHÂN TÍCH AI" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,6" />
        <TextBox Name="AiOutputTextBox" Grid.Row="1" Style="{StaticResource ModernTextBox}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0B0F19" BorderBrush="#1E293B" />
      </Grid>
      <TextBlock Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475569" FontSize="10.5" LineHeight="14" Text="API key có thể nhập tại đây hoặc dùng biến môi trường GEMINI_API_KEY. Chỉ vùng snapshot được gửi lên, không gửi toàn bộ file." />
    </Grid>
  </Border>
</UserControl>
