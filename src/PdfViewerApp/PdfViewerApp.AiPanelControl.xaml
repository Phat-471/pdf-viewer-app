<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PdfViewerApp.AiPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <UserControl.Resources>
    <Style x:Key="QuickPromptBtn" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="Foreground" Value="#CBD5E1" />
      <Setter Property="BorderBrush" Value="#334155" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="FrameworkElement.Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#334155" />
                <Setter Property="Foreground" Value="#F8FAFC" />
                <Setter Property="BorderBrush" Value="#475569" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#0F172A" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Border x:Name="RootBorder" Margin="0,5,5,5" Background="#111827" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="12">
    <Grid Margin="14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" /> <!-- Header -->
        <RowDefinition Height="Auto" /> <!-- Collapsible Config -->
        <RowDefinition Height="*" />    <!-- Chat History -->
        <RowDefinition Height="Auto" /> <!-- Chat Input & Prompts -->
      </Grid.RowDefinitions>

      <!-- Row 0: Header -->
      <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
        <TextBlock Name="AiPanelTitle" Text="Trợ Lý AI" FontWeight="Black" FontSize="16" Foreground="#38BDF8" DockPanel.Dock="Left" VerticalAlignment="Center">
          <UIElement.Effect>
            <DropShadowEffect Color="#38BDF8" BlurRadius="6" Opacity="0.2" ShadowDepth="0" />
          </UIElement.Effect>
        </TextBlock>
        <Button Content="" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="28" Height="28" HorizontalAlignment="Right" DockPanel.Dock="Right" Style="{StaticResource AiActionBtn}" Click="Close_Click" Margin="4,0,0,0" ToolTip="Đóng Panel" />
        <Button Name="ToggleConfigBtn" Content="" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="28" Height="28" HorizontalAlignment="Right" DockPanel.Dock="Right" Style="{StaticResource AiActionBtn}" Click="ToggleConfig_Click" ToolTip="Cài đặt AI" />
        <Button Name="ClearChatBtn" Content="" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="28" Height="28" HorizontalAlignment="Right" DockPanel.Dock="Right" Style="{StaticResource AiActionBtn}" Click="ClearChat_Click" Margin="0,0,4,0" ToolTip="Xóa đoạn chat" />
      </DockPanel>

      <!-- Row 1: Collapsible Config -->
      <Border Name="AiConfigPanel" Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Name="ConfigTitleText" Text="CẤU HÌNH AI" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />
          
          <TextBlock Name="ConfigModeText" Text="CHẾ ĐỘ AI" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox Name="AiProviderModeComboBox" Style="{StaticResource ModernComboBox}" Width="110" Height="26" SelectedIndex="0" SelectionChanged="AnySettingsChanged">
              <ComboBoxItem Content="Auto" Tag="Auto" />
              <ComboBoxItem Content="Gemini" Tag="Gemini" />
              <ComboBoxItem Content="Local" Tag="Local" />
              <ComboBoxItem Content="Off" Tag="Off" />
            </ComboBox>
            <CheckBox Name="AiAllowOnlineCheckBox" Content="Online snapshot" IsChecked="True" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#F8FAFC" FontSize="11" Checked="AnySettingsChanged" Unchecked="AnySettingsChanged" />
          </StackPanel>

          <TextBlock Name="ConfigApiKeyText" Text="GEMINI API KEY" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4" />
          <TextBox Name="AiGeminiApiKeyTextBox" Style="{StaticResource ModernTextBox}" Height="26" Margin="0,0,0,10" TextChanged="AnySettingsChanged" />

          <TextBlock Name="ConfigModelText" Text="GEMINI MODEL (Đề xuất tiết kiệm token)" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4" />
          <ComboBox Name="AiGeminiModelComboBox" IsEditable="True" Style="{StaticResource ModernComboBox}" Height="28" Margin="0,0,0,10" SelectionChanged="AnySettingsChanged">
            <ComboBoxItem Content="gemini-3.5-flash (Nhanh &amp; Tiết kiệm)" Tag="gemini-3.5-flash" />
            <ComboBoxItem Content="gemini-3.1-flash-lite (Siêu rẻ)" Tag="gemini-3.1-flash-lite" />
            <ComboBoxItem Content="gemini-2.5-flash (Thế hệ cũ ổn định)" Tag="gemini-2.5-flash" />
            <ComboBoxItem Content="gemini-3.5-pro (Mạnh nhất - CAD)" Tag="gemini-3.5-pro" />
          </ComboBox>

          <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
            <CheckBox Name="AiEnableTelemetryCheckBox" Content="Gửi báo cáo lỗi" IsChecked="False" Margin="0,0,10,0" Foreground="#F8FAFC" FontSize="11" Checked="AnySettingsChanged" Unchecked="AnySettingsChanged" />
            <CheckBox Name="AiEnableUpdateCheckCheckBox" Content="Tự động cập nhật" IsChecked="False" Foreground="#F8FAFC" FontSize="11" Checked="AnySettingsChanged" Unchecked="AnySettingsChanged" />
          </StackPanel>

          <WrapPanel Margin="0,8,0,0">
            <Button Content="Lấy Gemini API" Style="{StaticResource AiActionBtn}" Margin="0,0,6,4" Click="OpenGeminiApiKey_Click" Height="22" Padding="6,2" FontSize="10" />
            <Button Content="Cài Local AI" Style="{StaticResource AiActionBtn}" Margin="0,0,6,4" Click="OpenOllamaDownload_Click" Height="22" Padding="6,2" FontSize="10" />
            <Button Content="Kiểm tra AI" Style="{StaticResource AiActionBtn}" Margin="0,0,6,4" Click="CheckAi_Click" Height="22" Padding="6,2" FontSize="10" />
            <Button Content="Lưu cấu hình" Style="{StaticResource AiActionBtn}" Margin="0,0,6,4" Click="SaveAiSettings_Click" Height="22" Padding="6,2" FontSize="10" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Row 2: Chat History -->
      <ScrollViewer Name="ChatScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
        <StackPanel Name="ChatMessagesStackPanel" VerticalAlignment="Bottom">
          <!-- Chat bubbles will be added programmatically here -->
          <Border Background="#1E293B" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <TextBlock Text="Chào bạn! Tôi là trợ lý AI. Bạn có thể chọn phạm vi phân tích bên dưới, sau đó chụp một vùng bản vẽ hoặc hỏi trực tiếp về toàn bộ trang PDF đang mở." Foreground="#CBD5E1" FontSize="12.5" TextWrapping="Wrap" LineHeight="17" />
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Row 3: Chat Input & Prompts -->
      <StackPanel Grid.Row="3">
        <!-- Quick prompts (CAD chips) -->
        <TextBlock Name="QuickPromptTitleText" Text="Ý KIẾN NHANH (CAD)" FontSize="9" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
          <StackPanel Orientation="Horizontal">
            <Button Content="🔍 Giải thích bản vẽ" Style="{StaticResource QuickPromptBtn}" Click="QuickPrompt_Click" Tag="Hãy phân tích vùng bản vẽ kỹ thuật này và giải thích chi tiết các thành phần chính có trong ảnh." Height="24" Padding="8,2" />
            <Button Content="📏 Đọc kích thước" Style="{StaticResource QuickPromptBtn}" Click="QuickPrompt_Click" Tag="Hãy quét và đọc chính xác tất cả thông số kích thước, khoảng cách hoặc cao độ trong vùng bản vẽ này." Height="24" Padding="8,2" />
            <Button Content="📐 Giải nghĩa ký hiệu" Style="{StaticResource QuickPromptBtn}" Click="QuickPrompt_Click" Tag="Liệt kê và giải thích ý nghĩa các ký hiệu kỹ thuật, ký hiệu vật liệu hoặc ký hiệu thiết bị trong ảnh." Height="24" Padding="8,2" />
            <Button Content="🚧 Tìm điểm bất thường" Style="{StaticResource QuickPromptBtn}" Click="QuickPrompt_Click" Tag="Hãy kiểm tra kỹ vùng bản vẽ này để phát hiện nét vẽ chồng chéo, chữ bị đè, lỗi hiển thị hoặc điểm bất thường nào." Height="24" Padding="8,2" />
          </StackPanel>
        </ScrollViewer>

        <!-- Scope selector & Send bar -->
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          
          <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,0,0,6">
            <TextBlock Name="ScopeTitleText" Text="Phạm vi:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
            <RadioButton Name="ScopeSnapshotRadio" Content="Vùng chụp (Snapshot)" Foreground="#F8FAFC" FontSize="11" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" />
            <RadioButton Name="ScopeWholePageRadio" Content="Toàn bộ trang" Foreground="#F8FAFC" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="50" />
          </Grid.ColumnDefinitions>
          <TextBox Name="AiPromptTextBox" Style="{StaticResource ModernTextBox}" Height="54" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="Hãy đọc và giải thích vùng bản vẽ này." FontSize="12.5" Padding="6,6" Margin="0,24,6,0" PreviewKeyDown="AiPromptTextBox_PreviewKeyDown" />
          <Button Name="SendBtn" Grid.Column="1" Style="{StaticResource AiActionBtn}" Background="#38BDF8" BorderThickness="0" Margin="0,24,0,0" Height="54" Click="Send_Click" ToolTip="Gửi câu hỏi (Ctrl+Enter)">
            <Grid>
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </Grid>
        
        <TextBlock Name="BottomNoteText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#475569" FontSize="9.5" LineHeight="13" Text="Sử dụng mô hình Gemini API thế hệ mới. Toàn bộ hội thoại được lưu trữ trong suốt thời gian chạy." />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
