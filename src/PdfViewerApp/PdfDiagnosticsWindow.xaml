<Window x:Class="PdfViewerApp.PdfDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chẩn Đoán Hiệu Năng Tải PDF" Height="520" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Metadata & Diagnostics breakdown -->
            <RowDefinition Height="*"/>
            <!-- Recommendations & Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="CHẨN ĐOÁN HIỆU NĂNG TẢI FILE" Foreground="#38BDF8" FontSize="18" FontWeight="Bold"/>
            <TextBlock Name="FileNameText" Text="Tên file: N/A" Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Diagnostics panel -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- File Meta Box -->
                <Border Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Thông tin tài liệu:" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Dung lượng: " Foreground="#94A3B8"/>
                                <TextBlock Name="FileSizeText" Text="N/A" Foreground="#F8FAFC" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Số trang: " Foreground="#94A3B8"/>
                                <TextBlock Name="PageCountText" Text="N/A" Foreground="#F8FAFC" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Hiệu năng &amp; Trực quan:" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Bộ nhớ đệm (Cache): " Foreground="#94A3B8"/>
                                <TextBlock Name="CacheStateText" Text="N/A" Foreground="#34D399" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="Tổng thời gian tải: " Foreground="#94A3B8"/>
                                <TextBlock Name="TotalLoadTimeText" Text="N/A" Foreground="#F59E0B" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Detailed Breakdown Bars -->
                <TextBlock Text="Chi tiết thời gian xử lý (mili-giây):" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <StackPanel Margin="0,0,0,15">
                    <!-- FPDF_LoadDocument -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tải File (Mở Handle)" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        <ProgressBar Name="BarLoadDoc" Grid.Column="1" Height="14" Minimum="0" Maximum="1000" Value="0" Foreground="#38BDF8" Background="#1E293B" BorderThickness="0"/>
                        <TextBlock Name="ValLoadDocText" Grid.Column="2" Text="0 ms" Foreground="#F8FAFC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- FPDF_GetPageCount -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Đọc số trang" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        <ProgressBar Name="BarPageCount" Grid.Column="1" Height="14" Minimum="0" Maximum="500" Value="0" Foreground="#38BDF8" Background="#1E293B" BorderThickness="0"/>
                        <TextBlock Name="ValPageCountText" Grid.Column="2" Text="0 ms" Foreground="#F8FAFC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- CollectPageDimensions -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Quét kích thước các trang" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        <ProgressBar Name="BarDimensions" Grid.Column="1" Height="14" Minimum="0" Maximum="2000" Value="0" Foreground="#38BDF8" Background="#1E293B" BorderThickness="0"/>
                        <TextBlock Name="ValDimensionsText" Grid.Column="2" Text="0 ms" Foreground="#F8FAFC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Initial Render -->
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Dựng hình trang đầu tiên" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        <ProgressBar Name="BarRender" Grid.Column="1" Height="14" Minimum="0" Maximum="2000" Value="0" Foreground="#38BDF8" Background="#1E293B" BorderThickness="0"/>
                        <TextBlock Name="ValRenderText" Grid.Column="2" Text="0 ms" Foreground="#F8FAFC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Recommendations Box -->
                <TextBlock Text="Đánh giá &amp; Đề xuất tối ưu:" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,5,0,8"/>
                <Border Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
                    <TextBlock Name="RecommendationText" Text="Đang phân tích hiệu năng..." Foreground="#E2E8F0" TextWrapping="Wrap" FontSize="13" LineHeight="1.5"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Button Name="CloseBtn" Style="{StaticResource ModernButton}" Content="Đóng cửa sổ" Click="Close_Click" Background="#475569" HorizontalAlignment="Right" Width="120"/>
        </Grid>
    </Grid>
</Window>
