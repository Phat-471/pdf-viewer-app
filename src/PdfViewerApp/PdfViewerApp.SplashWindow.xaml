<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PdfViewerApp.SplashWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PDF Pro Workspace" Width="720" Height="420" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" ShowInTaskbar="False" Background="#00FFFFFF" Foreground="#F8FAFC" FontFamily="Segoe UI, Tahoma, Helvetica">
  <Grid Margin="18">
    <Border CornerRadius="26" BorderBrush="#1E293B" BorderThickness="1" Background="#0B1220">
      <Border.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.35" Color="#000000" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Height="5" VerticalAlignment="Top">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#0F766E" Offset="0.0" />
              <GradientStop Color="#06B6D4" Offset="0.5" />
              <GradientStop Color="#38BDF8" Offset="1.0" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Grid Grid.Row="1" Margin="32,28,32,18">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="176" Height="176" CornerRadius="44" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="{StaticResource AppLogoImage}" Width="108" Height="108" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
            <TextBlock Text="PDF Pro Workspace" FontSize="34" FontWeight="Black" Foreground="#F8FAFC">
              <UIElement.Effect>
                <DropShadowEffect Color="#38BDF8" BlurRadius="10" Opacity="0.25" ShadowDepth="0" />
              </UIElement.Effect>
            </TextBlock>
            <TextBlock Text="Engineering PDF workspace" FontSize="15" Foreground="#94A3B8" Margin="0,6,0,0" />
            <TextBlock Name="VersionTextBlock" Text="v1.0.0" FontSize="13" Foreground="#38BDF8" Margin="0,14,0,0" FontWeight="SemiBold" />
            <TextBlock Text="Đang nạp giao diện, engine PDF và hồ sơ làm việc..." FontSize="14" Foreground="#CBD5E1" Margin="0,18,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
              <Ellipse Width="10" Height="10" Fill="#38BDF8" Opacity="0.55" Margin="0,0,8,0">
                <Ellipse.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7" AutoReverse="True" />
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Ellipse.Triggers>
              </Ellipse>
              <Ellipse Width="10" Height="10" Fill="#38BDF8" Opacity="0.55" Margin="0,0,8,0">
                <Ellipse.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.2">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7" AutoReverse="True" />
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Ellipse.Triggers>
              </Ellipse>
              <Ellipse Width="10" Height="10" Fill="#38BDF8" Opacity="0.55">
                <Ellipse.Triggers>
                  <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever" BeginTime="0:0:0.4">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7" AutoReverse="True" />
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Ellipse.Triggers>
              </Ellipse>
            </StackPanel>
          </StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1,1,1,0" CornerRadius="0,0,26,26" Padding="24,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="#64748B" FontSize="12">
              <Run Text="Logo mới" />
              <Run Text=" · " />
              <Run Text="UI premium dark" />
              <Run Text=" · " />
              <Run Text="Rollback an toàn" />
            </TextBlock>
            <ProgressBar Grid.Column="1" Width="170" Height="8" IsIndeterminate="True" Foreground="#38BDF8" Background="#1E293B" BorderThickness="0" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
