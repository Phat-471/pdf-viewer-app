<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>PdfViewerApp</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>11.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Include="PdfViewerApp.App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="assets\hphat_logo_1780279208636.png" />
    <EmbeddedResource Include="assets\hphat_logo_1780279208636.png" LogicalName="assets/hphat_logo_1780279208636.png" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Fluent">
      <HintPath>Fluent.dll</HintPath>
    </Reference>
    <Reference Include="ControlzEx">
      <HintPath>ControlzEx.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
     <PackageReference Include="PdfSharp" Version="6.1.1" />
     <PackageReference Include="Obfuscar" Version="2.2.38" GeneratePathProperty="true">
       <PrivateAssets>all</PrivateAssets>
       <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
     </PackageReference>
     <PackageReference Include="Tesseract" Version="5.2.0" />
   </ItemGroup>
  <Target Name="Obfuscate" AfterTargets="AfterBuild" Condition=" '$(Configuration)' == 'Release' ">
    <PropertyGroup>
      <ObfuscarExe>$(PkgObfuscar)\tools\Obfuscar.Console.exe</ObfuscarExe>
      <ObfuscarExe Condition="!Exists('$(ObfuscarExe)')">$(UserProfile)\.nuget\packages\obfuscar\2.2.38\tools\Obfuscar.Console.exe</ObfuscarExe>
    </PropertyGroup>
    <ItemGroup>
      <ObfuscarScriptLines Include="$netCore = (Get-ChildItem 'C:\Program Files\dotnet\shared\Microsoft.NETCore.App' -Name -Filter '8.0.*' | Sort-Object | Select-Object -Last 1)" />
      <ObfuscarScriptLines Include="$desktop = (Get-ChildItem 'C:\Program Files\dotnet\shared\Microsoft.WindowsDesktop.App' -Name -Filter '8.0.*' | Sort-Object | Select-Object -Last 1)" />
      <ObfuscarScriptLines Include="Write-Host &quot;Detected .NET SDK Versions: NETCore=$netCore, Desktop=$desktop&quot;" />
      <ObfuscarScriptLines Include="$config = Get-Content '$(ProjectDir)obfuscar.xml' -Raw" />
      <ObfuscarScriptLines Include="$config = $config -replace 'Microsoft.NETCore.App\\8.0\.\d+', (&quot;Microsoft.NETCore.App\&quot; + $netCore)" />
      <ObfuscarScriptLines Include="$config = $config -replace 'Microsoft.WindowsDesktop.App\\8.0\.\d+', (&quot;Microsoft.WindowsDesktop.App\&quot; + $desktop)" />
      <ObfuscarScriptLines Include="$config | Set-Content '$(TargetDir)obfuscar.temp.xml' -Encoding utf8" />
    </ItemGroup>
    <WriteLinesToFile File="$(TargetDir)obfuscar_prep.ps1" Lines="@(ObfuscarScriptLines)" Overwrite="true" Encoding="utf-8" />
    <Exec Command="powershell -NonInteractive -ExecutionPolicy Bypass -File &quot;$(TargetDir)obfuscar_prep.ps1&quot;" />
    <Delete Files="$(TargetDir)obfuscar_prep.ps1" />
    <Message Text="Running Obfuscar on $(TargetPath) using dynamic config $(TargetDir)obfuscar.temp.xml..." Importance="high" />
    <Exec Command="&quot;$(ObfuscarExe)&quot; &quot;$(TargetDir)obfuscar.temp.xml&quot;" WorkingDirectory="$(TargetDir)" />
    <Delete Files="$(TargetDir)obfuscar.temp.xml" />
    <Message Text="Copying obfuscated assembly back to target path..." Importance="high" />
    <Copy SourceFiles="$(TargetDir)Obfuscated\$(TargetFileName)" DestinationFolder="$(TargetDir)" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(TargetDir)Obfuscated\$(TargetName).pdb" DestinationFolder="$(TargetDir)" OverwriteReadOnlyFiles="true" Condition="Exists('$(TargetDir)Obfuscated\$(TargetName).pdb')" />
  </Target>
</Project>
