<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>PdfViewerApp</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>11.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Include="PdfViewerApp.App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="assets\hphat_logo_1780279208636.png" />
    <EmbeddedResource Include="assets\hphat_logo_1780279208636.png" LogicalName="assets/hphat_logo_1780279208636.png" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Fluent">
      <HintPath>Fluent.dll</HintPath>
    </Reference>
    <Reference Include="ControlzEx">
      <HintPath>ControlzEx.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PdfSharp" Version="6.1.1" />
    <PackageReference Include="Obfuscar" Version="2.2.38" GeneratePathProperty="true">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <Target Name="Obfuscate" AfterTargets="AfterBuild" Condition=" '$(Configuration)' == 'Release' ">
    <PropertyGroup>
      <ObfuscarExe>$(PkgObfuscar)\tools\Obfuscar.Console.exe</ObfuscarExe>
      <ObfuscarExe Condition="!Exists('$(ObfuscarExe)')">$(UserProfile)\.nuget\packages\obfuscar\2.2.38\tools\Obfuscar.Console.exe</ObfuscarExe>
    </PropertyGroup>
    <Message Text="Running Obfuscar on $(TargetPath) using config $(ProjectDir)obfuscar.xml..." Importance="high" />
    <Exec Command="&quot;$(ObfuscarExe)&quot; &quot;$(ProjectDir)obfuscar.xml&quot;" WorkingDirectory="$(TargetDir)" />
    <Message Text="Copying obfuscated assembly back to target path..." Importance="high" />
    <Copy SourceFiles="$(TargetDir)Obfuscated\$(TargetFileName)" DestinationFolder="$(TargetDir)" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(TargetDir)Obfuscated\$(TargetName).pdb" DestinationFolder="$(TargetDir)" OverwriteReadOnlyFiles="true" Condition="Exists('$(TargetDir)Obfuscated\$(TargetName).pdb')" />
  </Target>
</Project>
