<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PdfViewerApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fluent="urn:fluent-ribbon" Title="PDF Pro Workspace" Height="850" Width="1300" WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="#0B0F19" AllowDrop="True" WindowStyle="SingleBorderWindow" xmlns:pdfviewerapp="clr-namespace:PdfViewerApp;assembly=PdfViewerApp" Drop="MainWindow_Drop" DragOver="MainWindow_DragOver">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
  </WindowChrome.WindowChrome>
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type TabControl}" TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabControl}">
              <Grid KeyboardNavigation.TabNavigation="Local">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TabPanel Name="HeaderPanel" Grid.Row="0" ZIndex="1" Margin="4,0,4,-1" IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" />
                <Border Name="ContentPanel" Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1,1,1,1" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
                  <ContentPresenter Name="PART_SelectedContentHost" Margin="0" ContentSource="SelectedContent" />
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <DataTrigger Value="True" Binding="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=Window}}">
                  <Setter TargetName="ContentPanel" Property="Border.Background" Value="#0B0F19" />
                  <Setter TargetName="ContentPanel" Property="Border.BorderBrush" Value="#1E293B" />
                </DataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="#475569" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabItem}">
              <Border Name="TabBorder" CornerRadius="6,6,0,0" BorderThickness="1,1,1,1" BorderBrush="#E2E8F0" Background="#F1F5F9" Margin="2,2,2,0" Padding="12,6,12,6">
                <ContentPresenter Name="ContentSite" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Control.Foreground}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="TabItem.IsSelected" Value="True">
                  <Setter TargetName="TabBorder" Property="Border.Background" Value="#FFFFFF" />
                  <Setter TargetName="TabBorder" Property="Border.BorderBrush" Value="#E2E8F0" />
                  <Setter TargetName="TabBorder" Property="Border.BorderThickness" Value="1,1,1,0" />
                  <Setter TargetName="TabBorder" Property="Margin" Value="2,0,2,0" />
                  <Setter TargetName="TabBorder" Property="Border.Padding" Value="12,8,12,6" />
                  <Setter Property="Foreground" Value="#0F766E" />
                </Trigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="UIElement.IsMouseOver" Value="True" />
                    <Condition Property="TabItem.IsSelected" Value="False" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="TabBorder" Property="Border.Background" Value="#E2E8F0" />
                  <Setter Property="Foreground" Value="#0F172A" />
                </MultiTrigger>
                <DataTrigger Value="True" Binding="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=Window}}">
                  <Setter TargetName="TabBorder" Property="Border.Background" Value="#1E293B" />
                  <Setter TargetName="TabBorder" Property="Border.BorderBrush" Value="#334155" />
                  <Setter TargetName="TabBorder" Property="Border.BorderThickness" Value="1" />
                  <Setter Property="Foreground" Value="#94A3B8" />
                </DataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="True" Binding="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Condition Value="True" Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" />
                    <Condition Value="False" Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" />
                  </MultiDataTrigger.Conditions>
                  <Setter TargetName="TabBorder" Property="Border.Background" Value="#334155" />
                  <Setter Property="Foreground" Value="#F8FAFC" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Value="True" Binding="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Condition Value="True" Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource Self}}" />
                  </MultiDataTrigger.Conditions>
                  <Setter TargetName="TabBorder" Property="Border.Background" Value="#0B0F19" />
                  <Setter TargetName="TabBorder" Property="Border.BorderBrush" Value="#1E293B" />
                  <Setter TargetName="TabBorder" Property="Border.BorderThickness" Value="1,1,1,0" />
                  <Setter TargetName="TabBorder" Property="Margin" Value="2,0,2,0" />
                  <Setter TargetName="TabBorder" Property="Border.Padding" Value="12,8,12,6" />
                  <Setter Property="Foreground" Value="#FFFFFF" />
                </MultiDataTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="MainRootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Name="TitleBarGrid" Row="0" Height="40" Background="#0F172A">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
        <Border Width="26" Height="26" CornerRadius="8" Margin="0,0,10,0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1">
          <Image Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Path=Icon, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Border>
        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
          <TextBlock Name="TitleBarText" Foreground="#F8FAFC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Path=Title, RelativeSource={RelativeSource AncestorType=Window}}" />
          <TextBlock Name="TitleBarSubtitle" Foreground="#94A3B8" FontSize="9" Margin="0,-1,0,0" Text="Engineering PDF workspace" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
        <Button Name="BtnMinimize" Width="46" Height="40" Background="#00FFFFFF" BorderThickness="0" WindowChrome.IsHitTestVisibleInChrome="True" Click="Minimize_Click">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Border" Background="#00FFFFFF">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Border.Background" Value="#1E293B" />
                  <Setter Property="TextBlock.Foreground" Value="#F8FAFC" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Control.Template>
        </Button>
        <Button Name="BtnMaximize" Width="46" Height="40" Background="#00FFFFFF" BorderThickness="0" WindowChrome.IsHitTestVisibleInChrome="True" Click="Maximize_Click">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Border" Background="#00FFFFFF">
                <TextBlock Name="MaxIcon" FontFamily="Segoe MDL2 Assets" Text="" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Border.Background" Value="#1E293B" />
                  <Setter Property="TextBlock.Foreground" Value="#F8FAFC" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Control.Template>
        </Button>
        <Button Name="BtnClose" Width="46" Height="40" Background="#00FFFFFF" BorderThickness="0" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Border" Background="#00FFFFFF">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Border.Background" Value="#E81123" />
                  <Setter Property="TextBlock.Foreground" Value="#FFFFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Control.Template>
        </Button>
      </StackPanel>
    </Grid>
    <Grid Name="RibbonHostContainer" Grid.Row="1" />
    <StackPanel Grid.Row="2">
      <Border Name="UpdateNotificationBanner" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="0,0,0,1" Padding="16,8" Visibility="Collapsed">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Cập nhật ngay" Padding="14,6" Margin="0,0,8,0" Background="#2563EB" Foreground="#FFFFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="UpdateNotificationAction_Click">
              <FrameworkElement.Resources>
                <ResourceDictionary>
                  <Style x:Key="{x:Type Border}" TargetType="{x:Type Border}">
                    <Setter Property="Border.CornerRadius" Value="4" />
                  </Style>
                </ResourceDictionary>
              </FrameworkElement.Resources>
            </Button>
            <Button Content="Ẩn" Padding="14,6" Background="#FFFFFF" Foreground="#1E3A8A" FontWeight="SemiBold" BorderBrush="#93C5FD" BorderThickness="1" Cursor="Hand" Click="HideUpdateNotification_Click">
              <FrameworkElement.Resources>
                <ResourceDictionary>
                  <Style x:Key="{x:Type Border}" TargetType="{x:Type Border}">
                    <Setter Property="Border.CornerRadius" Value="4" />
                  </Style>
                </ResourceDictionary>
              </FrameworkElement.Resources>
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="16" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0" />
            <StackPanel>
              <TextBlock Name="UpdateNotificationTitleText" Text="Có bản cập nhật mới" Foreground="#1E3A8A" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
              <TextBlock Name="UpdateNotificationDetailText" Text="Mở bản cập nhật để xem chi tiết và cài đặt." Foreground="#1D4ED8" FontSize="12" Margin="0,2,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Name="ActivationWarningBanner" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="0,0,0,1" Padding="16,8" Visibility="Collapsed">
        <DockPanel>
          <Button Content="Kích hoạt ngay" DockPanel.Dock="Right" Padding="14,6" Background="#DC2626" Foreground="#FFFFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="Activation_Click">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <Style x:Key="{x:Type Border}" TargetType="{x:Type Border}">
                  <Setter Property="Border.CornerRadius" Value="4" />
                </Style>
              </ResourceDictionary>
            </FrameworkElement.Resources>
          </Button>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" FontSize="16" Foreground="#EF4444" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="Ứng dụng chưa được kích hoạt bản quyền. Vui lòng kích hoạt để sử dụng đầy đủ các tính năng nâng cao." Foreground="#991B1B" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
    <Grid Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Name="AiPanelColumn" Width="0" />
      </Grid.ColumnDefinitions>
      <Grid Column="0" Margin="5">
        <TabControl Name="PdfTabControl" BorderThickness="0" Background="#00FFFFFF" SelectionChanged="PdfTabControl_SelectionChanged" />
        <Border Name="ActiveToolOverlay" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,15,0,0" Background="#CC0F172A" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="8" Padding="16,10" Visibility="Collapsed" IsHitTestVisible="True">
          <UIElement.Effect>
            <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.5" ShadowDepth="3" />
          </UIElement.Effect>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,10,0" VerticalAlignment="Center">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Ellipse}">
                  <Style.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                      <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.2" Duration="0:0:0.8" AutoReverse="True" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Ellipse>
            <TextBlock Name="OverlayToolNameText" Text="ĐANG SỬ DỤNG: BÚT VẼ TỰ DO" Foreground="#F8FAFC" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
            <Separator Width="1" Height="16" Background="#475569" Margin="12,0" />
            <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="#F8FAFC" Background="#00FFFFFF" BorderThickness="0" Margin="4,0,0,0" Padding="4,2" Content="Hủy / Thoát chế độ" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="CancelMode_Click">
              <FrameworkElement.Resources>
                <ResourceDictionary>
                  <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
                    <Style.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="#F43F5E" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </ResourceDictionary>
              </FrameworkElement.Resources>
            </Button>
          </StackPanel>
        </Border>
                <Border Name="TabEmptyState" Background="#0F172A" CornerRadius="14" BorderThickness="1" BorderBrush="#1E293B" Visibility="Visible" Margin="0,0,0,0">
          <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Color="#000000" Opacity="0.30" />
          </Border.Effect>
          <Grid Name="DashboardHostContainer" Margin="18" />
        </Border>
      </Grid>
      <Grid Name="AiPanelHostContainer" Grid.Column="1" Margin="0,5,5,5" Visibility="Collapsed" />
    </Grid>
    <StatusBar Name="AppStatusBar" Grid.Row="4" Foreground="#FFFFFFFF" Height="34" Padding="10,0">
      <Control.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#0F172A" Offset="0" />
          <GradientStop Color="#1E293B" Offset="0.4" />
          <GradientStop Color="#0F766E" Offset="1" />
        </LinearGradientBrush>
      </Control.Background>
      <StatusBarItem>
        <TextBlock Name="StatusMessage" Text="Sẵn sàng" FontWeight="SemiBold" />
      </StatusBarItem>
      <Separator Name="ActiveToolSeparator" Background="#2B88D8" Margin="5,0" Visibility="Collapsed" />
      <StatusBarItem Name="ActiveToolStatusBarItem" Visibility="Collapsed">
        <Border Name="ActiveToolIndicator" Background="#0F766E" BorderBrush="#14B8A6" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="5,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center">
              <FrameworkElement.Style>
                <Style TargetType="{x:Type Ellipse}">
                  <Style.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                      <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                          <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.3" Duration="0:0:1" AutoReverse="True" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                  </Style.Triggers>
                </Style>
              </FrameworkElement.Style>
            </Ellipse>
            <TextBlock Name="ActiveToolText" Text="Công cụ: Xem tài liệu" Foreground="#FFFFFFFF" FontSize="11" FontWeight="Bold" />
          </StackPanel>
        </Border>
      </StatusBarItem>
      <Separator Background="#2B88D8" Margin="5,0" />
      <StatusBarItem>
        <TextBlock Name="LicenseStatusMessage" Text="Chưa kích hoạt" Foreground="#FCA5A5" FontWeight="SemiBold" />
      </StatusBarItem>
      <Separator Background="#2B88D8" Margin="5,0" />
      <StatusBarItem HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Trang:" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBox Name="PageJumpTextBox" Width="48" Height="22" HorizontalContentAlignment="Center" PreviewKeyDown="PageJumpTextBox_PreviewKeyDown" LostFocus="PageJumpTextBox_LostFocus" />
          <TextBlock Name="PageTotalText" Text="/ 0" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
      </StatusBarItem>
      <Separator HorizontalAlignment="Right" Background="#2B88D8" Margin="5,0" />
      <StatusBarItem HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Name="ZoomIndicator" Text="Thu phóng: 100%" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Slider Name="ZoomSlider" Width="150" Minimum="10" Maximum="400" TickFrequency="10" Value="100" ValueChanged="ZoomSlider_ValueChanged" />
        </StackPanel>
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>

