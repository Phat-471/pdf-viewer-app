<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PdfViewerApp.WelcomeDashboard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
  <UserControl.Resources>
    <Style x:Key="DashboardActionButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{DynamicResource DashboardBtnFg}" />
      <Setter Property="Background" Value="{DynamicResource DashboardBtnBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DashboardBtnBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FrameworkElement.Cursor" Value="Hand" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource DashboardBtnHoverBg}" />
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource DashboardBtnHoverBorder}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource DashboardBtnPressedBg}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RecentFileButton" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="{DynamicResource RecentFileBtnFg}" />
      <Setter Property="Background" Value="{DynamicResource RecentFileBtnBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RecentFileBtnBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Name="Border" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource RecentFileBtnHoverBg}" />
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource RecentFileBtnHoverBorder}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource RecentFileBtnPressedBg}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid Margin="0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="360" />
    </Grid.ColumnDefinitions>
    <Border Name="MainPanelBorder" Background="#0F172A" CornerRadius="14" BorderThickness="1" BorderBrush="#1E293B" Padding="32" Margin="0,0,16,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Name="LogoBorder" Width="76" Height="76" CornerRadius="22" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,18">
          <Image Width="48" Height="48" Source="{StaticResource AppLogoImage}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Name="WelcomeTitleText" Grid.Row="1" Text="Chưa mở tài liệu nào" FontSize="22" FontWeight="Black" Foreground="#F8FAFC" Margin="0,0,0,8" />
        <TextBlock Name="WelcomeSubtitleText" Grid.Row="2" Text="Kéo và thả file PDF vào đây, hoặc dùng tác vụ nhanh để mở, ghép, in và quay lại các file gần đây." FontSize="14" Foreground="#94A3B8" TextWrapping="Wrap" MaxWidth="520" Margin="0,0,0,20" />
        <WrapPanel Grid.Row="3">
          <Button Content="Mở File" Style="{StaticResource DashboardActionButton}" Margin="0,0,8,8" Padding="12,6" Click="OpenFile_Click" />
          <Button Content="Ghép File" Style="{StaticResource DashboardActionButton}" Margin="0,0,8,8" Padding="12,6" Click="MergeFile_Click" />
          <Button Content="In ấn" Style="{StaticResource DashboardActionButton}" Margin="0,0,8,8" Padding="12,6" Click="PrintFile_Click" />
          <Button Content="AI Snapshot" Style="{StaticResource DashboardActionButton}" Margin="0,0,8,8" Padding="12,6" Click="AiSnapshot_Click" />
          <Button Content="Cài đặt" Style="{StaticResource DashboardActionButton}" Margin="0,0,8,8" Padding="12,6" Click="Settings_Click" />
        </WrapPanel>
      </Grid>
    </Border>
    <Border Name="RecentFilesBorder" Grid.Column="1" Background="#111827" CornerRadius="14" BorderBrush="#1E293B" BorderThickness="1" Padding="18">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Name="RecentTitleText" Text="Tệp gần đây" FontSize="18" FontWeight="Black" Foreground="#F8FAFC" />
          <TextBlock Name="RecentSubtitleText" Text="Mở lại các tài liệu bạn đã dùng gần nhất." FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,12,0,0">
          <ItemsControl Name="RecentFilesItemsControl">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource RecentFileButton}" Click="RecentFile_Click">
                  <Button.Tag>
                    <Binding Path="FullPath" />
                  </Button.Tag>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource RecentFileIconBg}" BorderBrush="{DynamicResource RecentFileIconBorder}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock Text="PDF" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource RecentFileTextFg}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding DirectoryName}" Foreground="{DynamicResource RecentFileTextDescFg}" FontSize="10.5" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Name="EmptyRecentPanel" Background="{DynamicResource RecentFileIconBg}" BorderBrush="{DynamicResource RecentFileIconBorder}" BorderThickness="1" CornerRadius="12" Padding="16" Visibility="Visible">
            <StackPanel>
              <TextBlock Name="EmptyRecentText" Text="Chưa có lịch sử gần đây" Foreground="{DynamicResource RecentFileTextFg}" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Name="EmptyRecentDetailText" Text="Sau khi mở file, chúng sẽ xuất hiện ở đây để mở lại nhanh." Foreground="{DynamicResource RecentFileTextDescFg}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
