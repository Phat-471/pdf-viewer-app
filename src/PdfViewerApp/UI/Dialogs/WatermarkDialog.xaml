<Window x:Class="PdfViewerApp.WatermarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đóng Dấu Bản Quyền (Watermark)" Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A">
    <Window.Resources>
        <!-- Custom Styles for Premium UI -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="TextBox" x:Key="ModernTextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ScrollViewer Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox" x:Key="ModernComboBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Settings panel -->
            <RowDefinition Height="*"/>
            <!-- Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="ĐÓNG DẤU BẢN QUYỀN (WATERMARK)" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Thêm nhãn chữ mờ hoặc thông tin bản quyền đè lên tất cả các trang PDF." Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Content Panel -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Text content -->
                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                    <TextBlock Text="Nội dung chữ Watermark:" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="WatermarkTextBox" Style="{StaticResource ModernTextBox}" Text="CONFIDENTIAL" Height="32"/>
                </StackPanel>

                <!-- Opacity and Font Size -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                    <TextBlock Text="Độ trong suốt (Opacity):" Style="{StaticResource LabelStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" Value="0.3" TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}" Foreground="#38BDF8" Width="40" Margin="8,0,0,0" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,12">
                    <TextBlock Text="Cỡ chữ (Font Size):" Style="{StaticResource LabelStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="FontSizeSlider" Minimum="12" Maximum="120" Value="48" TickFrequency="1" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ElementName=FontSizeSlider, Path=Value, StringFormat={}{0:F0} pt}" Foreground="#38BDF8" Width="50" Margin="8,0,0,0" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>

                <!-- Angle and Color -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,12">
                    <TextBlock Text="Góc xoay (Degrees):" Style="{StaticResource LabelStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="AngleSlider" Minimum="-90" Maximum="90" Value="45" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ElementName=AngleSlider, Path=Value, StringFormat={}{0:F0}°}" Foreground="#38BDF8" Width="40" Margin="8,0,0,0" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,12">
                    <TextBlock Text="Màu sắc Watermark:" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="ColorComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="3" Height="32">
                        <ComboBoxItem Content="Đỏ (Red)" Tag="#EF4444"/>
                        <ComboBoxItem Content="Xanh Dương (Blue)" Tag="#3B82F6"/>
                        <ComboBoxItem Content="Xanh Lá (Green)" Tag="#10B981"/>
                        <ComboBoxItem Content="Xám (Gray)" Tag="#6B7280"/>
                        <ComboBoxItem Content="Đen (Black)" Tag="#000000"/>
                        <ComboBoxItem Content="Vàng (Yellow)" Tag="#F59E0B"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Name="StatusTextBlock" Text="Sẵn sàng đóng dấu." Foreground="#94A3B8" VerticalAlignment="Center" TextWrapping="Wrap" Grid.Column="0" Margin="0,0,10,0"/>

            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                <Button Name="CancelBtn" Style="{StaticResource ModernButton}" Content="Hủy" Click="Cancel_Click" Background="#475569" Margin="0,0,8,0"/>
                <Button Name="ApplyBtn" Style="{StaticResource ModernButton}" Content="Đóng Dấu" Click="Apply_Click" Background="#0EA5E9"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
