<Window x:Class="PdfViewerApp.WatermarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đóng Dấu Bản Quyền PDF (Watermark &amp; Stamp)" Height="520" Width="720"
        WindowStartupLocation="CenterOwner" Background="#090D16" Foreground="#F8FAFC"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#131C2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🛡️" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel>
                    <TextBlock Text="ĐÓNG DẤU BẢN QUYỀN VĂN BẢN (WATERMARK)" FontWeight="Bold" FontSize="15" Foreground="#F8FAFC" />
                    <TextBlock Text="Chèn chữ chìm, bảo vệ bản quyền bản vẽ CAD &amp; tài liệu PDF" Foreground="#94A3B8" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Body Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Settings Form -->
            <Border Grid.Column="0" Background="#131C2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Nội dung con dấu (Text Watermark)" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,6" />
                    <TextBox Name="WatermarkTextBox" Text="BẢN QUYỀN / BẢN VẼ MẪU" Style="{StaticResource ModernTextBox}" Height="34" Margin="0,0,0,14" TextChanged="WatermarkSettings_Changed" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="Cỡ chữ (pt)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4" />
                            <ComboBox Name="FontSizeComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="2" SelectionChanged="WatermarkSettings_Changed">
                                <ComboBoxItem Content="36 pt" Tag="36" />
                                <ComboBoxItem Content="48 pt" Tag="48" />
                                <ComboBoxItem Content="64 pt" Tag="64" />
                                <ComboBoxItem Content="80 pt" Tag="80" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="Góc xoay (Nghiêng)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4" />
                            <ComboBox Name="AngleComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="1" SelectionChanged="WatermarkSettings_Changed">
                                <ComboBoxItem Content="Ngang (0°)" Tag="0" />
                                <ComboBoxItem Content="Nghiêng (45°)" Tag="45" />
                                <ComboBoxItem Content="Dọc (90°)" Tag="90" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Độ trong suốt (Opacity)" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Slider Name="OpacitySlider" Minimum="0.1" Maximum="1.0" Value="0.35" VerticalAlignment="Center" ValueChanged="WatermarkSettings_Changed" />
                        <TextBlock Grid.Column="1" Name="OpacityValueText" Text="35%" Foreground="#F8FAFC" FontWeight="Bold" Margin="10,0,0,0" Width="40" />
                    </Grid>

                    <TextBlock Text="Màu sắc con dấu" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4" />
                    <ComboBox Name="ColorComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0" SelectionChanged="WatermarkSettings_Changed" Margin="0,0,0,14">
                        <ComboBoxItem Content="Đỏ (Red)" Tag="#EF4444" />
                        <ComboBoxItem Content="Xám nhạt (Light Gray)" Tag="#94A3B8" />
                        <ComboBoxItem Content="Xanh Dương (Blue)" Tag="#3B82F6" />
                        <ComboBoxItem Content="Đen (Black)" Tag="#000000" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Preview Card -->
            <Border Grid.Column="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid Name="PreviewPaperCanvas" Background="#FFFFFF">
                    <TextBlock Text="XEM TRƯỚC TRANG PDF" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,15,0,0" />
                    <!-- Watermark Overlay Preview -->
                    <TextBlock Name="WatermarkPreviewText" Text="BẢN QUYỀN" Foreground="#EF4444" Opacity="0.35" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="45" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Đóng dấu ngay" Style="{StaticResource PremiumButton}" Width="130" Margin="0,0,10,0" Click="Apply_Click" IsDefault="True" />
            <Button Content="Hủy" Style="{StaticResource SecondaryButton}" Width="90" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
