<Window x:Class="PdfViewerApp.CompressPdfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tối Ưu &amp; Nén Dung Lượng PDF" Height="440" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Loaded="Window_Loaded">
    <Window.Resources>
        <!-- Custom Styles for Premium UI -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="RadioButton" x:Key="ModernRadioButton">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Info and selection -->
            <RowDefinition Height="*"/>
            <!-- Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="TỐI ƯU HÓA DUNG LƯỢNG PDF" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Nén và giảm kích thước hình ảnh để dễ dàng chia sẻ, in ấn." Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Selection panel -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <!-- File size info -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Dung lượng hiện tại: " Foreground="#94A3B8"/>
                    <TextBlock Name="OriginalSizeText" Text="0 MB" Foreground="#38BDF8" FontWeight="Bold"/>
                </StackPanel>

                <!-- Compress levels -->
                <TextBlock Text="Chọn mức độ nén:" Foreground="#F8FAFC" FontWeight="Bold" Margin="0,0,0,4"/>
                
                <RadioButton Name="RadioLossless" Style="{StaticResource ModernRadioButton}" IsChecked="True">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Nén Tối Ưu (Không giảm nét hình ảnh)" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock Text="Tối ưu cấu trúc PDF, giữ nguyên 100% độ sắc nét ban đầu" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton Name="RadioLow" Style="{StaticResource ModernRadioButton}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Nén Thấp (Chất lượng ảnh tốt)" FontWeight="Bold"/>
                        <TextBlock Text="Giảm nhẹ dung lượng ảnh (JPEG 80%)" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton Name="RadioMedium" Style="{StaticResource ModernRadioButton}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Nén Trung Bình (Khuyên dùng)" FontWeight="Bold" Foreground="#34D399"/>
                        <TextBlock Text="Cân bằng hoàn hảo giữa dung lượng và độ chi tiết (JPEG 60%)" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton Name="RadioHigh" Style="{StaticResource ModernRadioButton}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Nén Cao (Dung lượng nhỏ nhất)" FontWeight="Bold"/>
                        <TextBlock Text="Nén tối đa ảnh, phù hợp chia sẻ nhanh (JPEG 35%)" Foreground="#94A3B8" FontSize="11"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Action Buttons & Status -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Name="StatusTextBlock" Text="Sẵn sàng nén." Foreground="#94A3B8" VerticalAlignment="Center" TextWrapping="Wrap" Grid.Column="0" Margin="0,0,10,0"/>

            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                <Button Name="CancelBtn" Style="{StaticResource ModernButton}" Content="Hủy" Click="Cancel_Click" Background="#475569" Margin="0,0,8,0"/>
                <Button Name="CompressBtn" Style="{StaticResource ModernButton}" Content="Tiến Hành Nén" Click="Compress_Click" Background="#0EA5E9"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
