<Window x:Class="PdfViewerApp.PdfSecurityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bảo Mật &amp; Cài Mật Khẩu PDF" Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A">
    <Window.Resources>
        <!-- Custom Styles for Premium UI -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="PasswordBox" x:Key="ModernPasswordBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ScrollViewer Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox" x:Key="ModernCheckBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Settings panel -->
            <RowDefinition Height="*"/>
            <!-- Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="BẢO MẬT &amp; CÀI MẬT KHẨU PDF" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Mã hóa tài liệu bằng mật khẩu và thiết lập quyền hạn in ấn, sao chép." Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Content Panel -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <!-- Passwords -->
                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Mật khẩu mở file (User Pass):" Style="{StaticResource LabelStyle}"/>
                        <PasswordBox x:Name="UserPasswordBox" Style="{StaticResource ModernPasswordBox}" Height="32"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Mật khẩu chủ (Owner Pass):" Style="{StaticResource LabelStyle}"/>
                        <PasswordBox x:Name="OwnerPasswordBox" Style="{StaticResource ModernPasswordBox}" Height="32"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Mẹo: Đặt mật khẩu chủ khác mật khẩu mở file để phân quyền." Foreground="#94A3B8" FontSize="11" Margin="0,0,0,15"/>

                <!-- Permissions -->
                <TextBlock Text="Thiết lập quyền hạn:" Foreground="#F8FAFC" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                
                <CheckBox x:Name="PrintCheckBox" Style="{StaticResource ModernCheckBox}" Content="Cho phép In ấn tài liệu (Permit Print)" IsChecked="True"/>
                <CheckBox x:Name="CopyCheckBox" Style="{StaticResource ModernCheckBox}" Content="Cho phép Sao chép nội dung chữ/ảnh (Permit Copy)" IsChecked="True"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Name="StatusTextBlock" Text="Sẵn sàng cấu hình bảo mật." Foreground="#94A3B8" VerticalAlignment="Center" TextWrapping="Wrap" Grid.Column="0" Margin="0,0,10,0"/>

            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                <Button Name="CancelBtn" Style="{StaticResource ModernButton}" Content="Hủy" Click="Cancel_Click" Background="#475569" Margin="0,0,8,0"/>
                <Button Name="ApplyBtn" Style="{StaticResource ModernButton}" Content="Lưu Bảo Mật" Click="Apply_Click" Background="#0EA5E9"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
