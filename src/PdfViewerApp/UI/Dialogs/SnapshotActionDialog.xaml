<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PdfViewerApp.SnapshotActionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Snapshot" Height="230" Width="460" MinHeight="230" MinWidth="420" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#0F172A" Foreground="#F8FAFC" FontFamily="Segoe UI, Tahoma" xmlns:pdfviewerapp="clr-namespace:PdfViewerApp;assembly=PdfViewerApp">
  <Window.Resources>
    <ResourceDictionary>
      <Style x:Key="PremiumButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Border" CornerRadius="6" Padding="12,8">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F766E" Offset="0.0" />
                    <GradientStop Color="#14B8A6" Offset="1.0" />
                  </LinearGradientBrush>
                </Border.Background>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="UIElement.Opacity" Value="0.9" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Border" Property="UIElement.Opacity" Value="0.8" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#94A3B8" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Border" CornerRadius="6" BorderThickness="1.5" BorderBrush="#334155" Background="#1E293B" Padding="10,6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Border.BorderBrush" Value="#475569" />
                  <Setter Property="Foreground" Value="#F8FAFC" />
                  <Setter TargetName="Border" Property="Border.Background" Value="#334155" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Border" Property="Border.Background" Value="#0F172A" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Đã chọn vùng snapshot" FontSize="18" FontWeight="SemiBold" Foreground="#38BDF8" />
    <StackPanel Grid.Row="1" Margin="0,14,0,12">
      <TextBlock Text="Chọn thao tác tiếp theo. Lệnh in sẽ dùng PDFium native để phóng vùng chọn lên toàn bộ trang in nên bản vẽ vẫn nét." TextWrapping="Wrap" Foreground="#94A3B8" />
      <TextBlock Name="SnapshotInfoText" Margin="0,10,0,0" Foreground="#64748B" TextWrapping="Wrap" />
    </StackPanel>
    <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
      <Button Content="In..." Style="{StaticResource PremiumButton}" Width="92" Height="32" Margin="0,0,8,0" IsDefault="True" Click="Print_Click" />
      <Button Content="Copy ảnh" Style="{StaticResource SecondaryButton}" Width="92" Height="32" Margin="0,0,8,0" Click="Copy_Click" />
      <Button Content="Lưu PNG" Style="{StaticResource SecondaryButton}" Width="92" Height="32" Margin="0,0,8,0" Click="Save_Click" />
      <Button Content="Hủy" Style="{StaticResource SecondaryButton}" Width="80" Height="32" IsCancel="True" Click="Cancel_Click" />
    </WrapPanel>
  </Grid>
</Window>