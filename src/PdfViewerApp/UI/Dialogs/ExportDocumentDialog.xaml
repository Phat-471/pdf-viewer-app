<Window x:Class="PdfViewerApp.UI.Dialogs.ExportDocumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xuất Tài Liệu PDF (Export)" Height="250" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8F9FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Chọn định dạng xuất tài liệu:" FontSize="16" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <RadioButton x:Name="RadioDocx" Content="Văn bản Microsoft Word (.docx / .txt)" IsChecked="True" FontSize="14" Margin="0,5"/>
            <RadioButton x:Name="RadioXlsx" Content="Bảng tính Microsoft Excel (.xlsx / .csv)" FontSize="14" Margin="0,5"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy bỏ" Width="90" Height="32" Margin="0,0,10,0" Click="BtnCancel_Click" Background="#E5E7EB" BorderBrush="Transparent"/>
            <Button Content="Xuất File" Width="100" Height="32" Click="BtnExport_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" BorderBrush="Transparent"/>
        </StackPanel>
    </Grid>
</Window>
