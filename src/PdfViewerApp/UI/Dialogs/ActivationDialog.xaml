<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PdfViewerApp.ActivationDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Kích Hoạt Bản Quyền PDF Pro" Width="500" Height="390" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#0F172A" Foreground="#F8FAFC" FontFamily="Segoe UI, Tahoma, Helvetica" xmlns:pdfviewerapp="clr-namespace:PdfViewerApp;assembly=PdfViewerApp">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="ModernTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="#1E293B" />
        <Setter Property="BorderBrush" Value="#475569" />
        <Setter Property="Foreground" Value="#F8FAFC" />
        <Setter Property="TextBoxBase.CaretBrush" Value="#38BDF8" />
        <Setter Property="TextBoxBase.SelectionBrush" Value="#38BDF8" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Name="Border" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8">
                <ScrollViewer Name="PART_ContentHost" Margin="0" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsFocused" Value="True">
                  <Setter TargetName="Border" Property="Border.BorderBrush" Value="#06B6D4" />
                  <Setter Property="Background" Value="#0F172A" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="PremiumButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Border" CornerRadius="8" Padding="16,10">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4F46E5" Offset="0.0" />
                    <GradientStop Color="#06B6D4" Offset="1.0" />
                  </LinearGradientBrush>
                </Border.Background>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="UIElement.Opacity" Value="0.9" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Border" Property="UIElement.Opacity" Value="0.8" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#94A3B8" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Border" CornerRadius="8" BorderThickness="1.5" BorderBrush="#334155" Background="#00FFFFFF" Padding="14,8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Border.BorderBrush" Value="#475569" />
                  <Setter Property="Foreground" Value="#F8FAFC" />
                  <Setter TargetName="Border" Property="Border.Background" Value="#1E293B" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Border" Property="Border.Background" Value="#0F172A" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DangerButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#EF4444" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Border" CornerRadius="8" BorderThickness="1" BorderBrush="#991B1B" Background="#1A0F0F" Padding="14,8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Border.Background" Value="#2D1414" />
                  <Setter Property="Foreground" Value="#FCA5A5" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Border" Property="Border.Background" Value="#451A1A" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Panel.Background>
      <RadialGradientBrush Center="0.5,0" RadiusX="0.8" RadiusY="0.8">
        <GradientStop Color="#1E1B4B" Offset="0" />
        <GradientStop Color="#0F172A" Offset="1" />
      </RadialGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Height="4" VerticalAlignment="Top">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#4F46E5" Offset="0.0" />
          <GradientStop Color="#A855F7" Offset="0.5" />
          <GradientStop Color="#06B6D4" Offset="1.0" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <StackPanel Grid.Row="0" Margin="24,24,24,12">
      <TextBlock Text="PDF PRO ACTIVATION" FontSize="20" FontWeight="Black" Foreground="#FFFFFFFF">
        <UIElement.Effect>
          <DropShadowEffect Color="#38BDF8" BlurRadius="8" Opacity="0.3" ShadowDepth="0" />
        </UIElement.Effect>
      </TextBlock>
      <TextBlock Text="Vui lòng nhập mã kích hoạt độc quyền dành cho thiết bị của bạn." FontSize="12" Foreground="#64748B" Margin="0,4,0,0" />
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="24,0,24,0">
      <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="MACHINE ID" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />
            <TextBlock Name="VersionTextBlock" Visibility="Collapsed" />
            <TextBlock Name="StatusTextBlock" FontSize="13" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0" />
          </StackPanel>
          <TextBox Name="MachineIdTextBox" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" FontSize="14" Background="#00FFFFFF" Foreground="#F1F5F9" BorderThickness="0" Padding="12,0,8,0" VerticalAlignment="Center" IsTabStop="False" />
          <Button Grid.Column="2" Content="Copy ID" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Click="CopyMachineId_Click" />
        </Grid>
      </Border>
      <StackPanel>
        <TextBlock Text="MÃ KÍCH HOẠT (LICENSE KEY)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="2,0,0,6" />
        <TextBox Name="ActivationKeyTextBox" Style="{StaticResource ModernTextBox}" FontFamily="Consolas" CharacterCasing="Upper" TextAlignment="Center" Height="40" FontSize="15" />
        <TextBlock Margin="2,10,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="#94A3B8">Liên hệ nhận key (Zalo, FB): <Hyperlink NavigateUri="https://zalo.me/0974194305" Foreground="#38BDF8" TextDecorations="None" FontWeight="Bold" RequestNavigate="Hyperlink_RequestNavigate">Zalo: 0974194305</Hyperlink></TextBlock>
      </StackPanel>
    </StackPanel>
    <Border Grid.Row="2" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="24,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="Gỡ bản quyền" Style="{StaticResource DangerButton}" Click="Deactivate_Click" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Kích hoạt ngay" Style="{StaticResource PremiumButton}" Width="150" Margin="0,0,12,0" IsDefault="True" Click="Activate_Click" />
          <Button Content="Đóng" Style="{StaticResource SecondaryButton}" Width="80" IsCancel="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>