<Window x:Class="PdfViewerApp.EditTextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sửa Chữ Trong PDF"
        Width="520" Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Tìm &amp; Thay thế chữ (giữ nguyên font, cỡ chữ, màu)"
                   FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Chữ cần tìm:" Foreground="#94A3B8" Margin="0,0,0,4"/>
            <TextBox x:Name="OldTextbox" Height="34" Padding="8,6"
                     Background="#111827" Foreground="#F8FAFC"
                     BorderBrush="#334155" BorderThickness="1"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Thay bằng:" Foreground="#94A3B8" Margin="0,0,0,4"/>
            <TextBox x:Name="NewTextbox" Height="34" Padding="8,6"
                     Background="#111827" Foreground="#F8FAFC"
                     BorderBrush="#334155" BorderThickness="1"/>
        </StackPanel>

        <CheckBox x:Name="WholeDocCheck" Grid.Row="3" Content="Áp dụng cho TOÀN BỘ file PDF"
                  IsChecked="True" Foreground="#CBD5E1" Margin="0,0,0,10"
                  FontSize="13"/>

        <TextBlock x:Name="StatusText" Grid.Row="4" Text=""
                   Foreground="#38BDF8" TextWrapping="Wrap" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Hủy" Width="100" Height="36"
                    Margin="0,0,10,0" Click="CancelButton_Click"
                    Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155"/>
            <Button x:Name="ApplyButton" Content="Thay thế" Width="120" Height="36"
                    Click="ApplyButton_Click"
                    Background="#0F766E" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
