<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PdfViewerApp.PrintProgressDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tiến trình in" Width="460" Height="210" MinWidth="420" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#0F172A" Foreground="#F8FAFC" FontFamily="Segoe UI, Tahoma" xmlns:pdfviewerapp="clr-namespace:PdfViewerApp;assembly=PdfViewerApp" Closing="Window_Closing">
  <Window.Resources>
    <ResourceDictionary>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#94A3B8" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Border" CornerRadius="6" BorderThickness="1.5" BorderBrush="#334155" Background="#1E293B" Padding="10,6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Border.BorderBrush" Value="#475569" />
                  <Setter Property="Foreground" Value="#F8FAFC" />
                  <Setter TargetName="Border" Property="Border.Background" Value="#334155" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Border" Property="Border.Background" Value="#0F172A" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ModernProgressBar" TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="#38BDF8" />
        <Setter Property="Background" Value="#1E293B" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ProgressBar}">
              <Grid Name="TemplateRoot">
                <Border CornerRadius="6" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" />
                <Border Name="PART_Indicator" CornerRadius="6" HorizontalAlignment="Left" Background="{TemplateBinding Control.Foreground}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Đang gửi lệnh in" FontSize="18" FontWeight="SemiBold" Foreground="#38BDF8" />
    <ProgressBar Name="PrintProgressBar" Grid.Row="1" Style="{StaticResource ModernProgressBar}" Margin="0,16,0,8" Minimum="0" Maximum="1" Value="0" IsIndeterminate="True" />
    <StackPanel Grid.Row="2">
      <TextBlock Name="StatusText" Text="Đang chuẩn bị..." TextWrapping="Wrap" Foreground="#CBD5E1" FontWeight="SemiBold" />
      <TextBlock Name="DetailText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#94A3B8" />
    </StackPanel>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Name="CancelButton" Content="Hủy lệnh" Style="{StaticResource SecondaryButton}" Width="96" Height="30" Click="Cancel_Click" />
      <Button Name="CloseButton" Content="Đóng" Style="{StaticResource SecondaryButton}" Width="80" Height="30" Margin="8,0,0,0" Visibility="Collapsed" Click="Close_Click" />
    </StackPanel>
  </Grid>
</Window>