<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PdfViewerApp.PrintOptionsDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="In tài liệu" Width="1120" Height="670" MinWidth="1040" MinHeight="580" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" Background="#0F172A" Foreground="#F8FAFC" FontFamily="Segoe UI, Tahoma, Helvetica" xmlns:pdfviewerapp="clr-namespace:PdfViewerApp;assembly=PdfViewerApp">
  <Window.Resources>
    <ResourceDictionary>
      <!-- Premium button style -->
      <Style x:Key="PremiumButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Border" CornerRadius="6" Padding="12,8">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F766E" Offset="0.0" />
                    <GradientStop Color="#14B8A6" Offset="1.0" />
                  </LinearGradientBrush>
                </Border.Background>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="UIElement.Opacity" Value="0.9" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Border" Property="UIElement.Opacity" Value="0.8" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Secondary button style -->
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#94A3B8" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Border" CornerRadius="6" BorderThickness="1.5" BorderBrush="#334155" Background="#1E293B" Padding="10,6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Border.BorderBrush" Value="#475569" />
                  <Setter Property="Foreground" Value="#F8FAFC" />
                  <Setter TargetName="Border" Property="Border.Background" Value="#334155" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Border" Property="Border.Background" Value="#0F172A" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Modern text box style -->
      <Style x:Key="ModernTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="#1E293B" />
        <Setter Property="Foreground" Value="#F8FAFC" />
        <Setter Property="BorderBrush" Value="#475569" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CaretBrush" Value="#38BDF8" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                <ScrollViewer Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="BorderBrush" Value="#64748B" />
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                  <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8" />
                  <Setter Property="Background" Value="#0F172A" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ToggleButton and ComboBox styles for PrintOptionsDialog -->
      <Style x:Key="ModernComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Name="templateRoot" Background="#1E293B" BorderBrush="#475569" BorderThickness="1.5" CornerRadius="6" SnapsToDevicePixels="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="1" Width="24" Background="Transparent" SnapsToDevicePixels="True">
                    <Path Name="Arrow" Fill="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" />
                  </Border>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="templateRoot" Property="Background" Value="#334155" />
                  <Setter TargetName="templateRoot" Property="BorderBrush" Value="#64748B" />
                  <Setter TargetName="Arrow" Property="Fill" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="templateRoot" Property="Background" Value="#0F172A" />
                  <Setter TargetName="templateRoot" Property="BorderBrush" Value="#38BDF8" />
                  <Setter TargetName="Arrow" Property="Fill" Value="#38BDF8" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="ModernComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="#1E293B" />
        <Setter Property="Foreground" Value="#F8FAFC" />
        <Setter Property="BorderBrush" Value="#475569" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid Name="templateRoot" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="0" MinWidth="{x:Static SystemParameters.VerticalScrollBarWidth}" />
                </Grid.ColumnDefinitions>
                <Popup Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom" Margin="1" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}">
                  <Border Name="dropDownBorder" MaxHeight="{TemplateBinding MaxDropDownHeight}" MinWidth="{Binding ElementName=templateRoot, Path=ActualWidth}" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="6" Margin="0,2,0,0">
                    <ScrollViewer Name="DropDownScrollViewer">
                      <Grid RenderOptions.ClearTypeHint="Enabled">
                        <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                          <Rectangle Name="OpaqueRect" Width="{Binding ElementName=dropDownBorder, Path=ActualWidth}" Height="{Binding ElementName=dropDownBorder, Path=ActualHeight}" Fill="{Binding ElementName=dropDownBorder, Path=Background}" />
                        </Canvas>
                        <ItemsPresenter Name="ItemsPresenter" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" KeyboardNavigation.DirectionalNavigation="Contained" />
                      </Grid>
                    </ScrollViewer>
                  </Border>
                </Popup>
                <ToggleButton Name="toggleButton" Grid.ColumnSpan="2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Style="{StaticResource ModernComboBoxToggleButton}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter Name="contentPresenter" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" Margin="{TemplateBinding Padding}" IsHitTestVisible="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="HasItems" Value="False">
                  <Setter TargetName="dropDownBorder" Property="Height" Value="95" />
                </Trigger>
                <Trigger Property="IsGrouping" Value="True">
                  <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#94A3B8" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBoxItem}">
              <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="4" Margin="2,1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Background" Value="#1E293B" />
                  <Setter Property="Foreground" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Border" Property="Background" Value="#0F766E" />
                  <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="#F8FAFC" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="#F8FAFC" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Top Area: Printer Selection -->
    <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Máy in:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CBD5E1" />
        <ComboBox Name="PrinterComboBox" Grid.Column="1" Style="{StaticResource ModernComboBox}" MinWidth="280" DisplayMemberPath="FullName" SelectionChanged="PrinterComboBox_SelectionChanged" />
        <TextBlock Grid.Column="2" Text="Số bản:" VerticalAlignment="Center" Margin="18,0,8,0" Foreground="#CBD5E1" />
        <TextBox Name="CopiesTextBox" Grid.Column="3" Style="{StaticResource ModernTextBox}" Text="1" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Height="28" />
        <Button Grid.Column="4" Content="Thuộc tính..." Style="{StaticResource SecondaryButton}" Width="95" Height="28" Margin="12,0,0,0" Click="PrinterProperties_Click" />
        <Button Grid.Column="5" Content="Test Máy In" Style="{StaticResource SecondaryButton}" Width="95" Height="28" Margin="8,0,0,0" Click="TestPrinter_Click" Background="#2563EB" Foreground="White" />
        <TextBlock Name="PrinterDefaultText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Margin="0,7,0,0" Foreground="#94A3B8" />

      </Grid>
    </Border>

    <!-- Middle Area: Preview and Options -->
    <Grid Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="390" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="250" />
      </Grid.ColumnDefinitions>

      <!-- Preview Column -->
      <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Xem trước" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC" Margin="0,0,0,8" />
          <Border Grid.Row="1" Background="#0A0F1D" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
            <Grid>
              <Image Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6" />
              <TextBlock Name="PreviewPlaceholderText" Text="PDF" FontSize="34" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

              <!-- Navigation Overlay -->
              <Grid VerticalAlignment="Bottom" Background="#D0000000" Height="40">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Name="PrevPageButton" Grid.Column="0" Content="‹" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" FontFamily="Segoe UI Symbol" FontSize="14" Click="PrevPage_Click" Focusable="False" Height="40" VerticalAlignment="Center" HorizontalAlignment="Stretch" Cursor="Hand" />
                <TextBlock Name="PageCounterOverlayText" Grid.Column="1" Text="1 / 1" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="15,0" />
                <Button Name="NextPageButton" Grid.Column="2" Content="›" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" FontFamily="Segoe UI Symbol" FontSize="14" Click="NextPage_Click" Focusable="False" Height="40" VerticalAlignment="Center" HorizontalAlignment="Stretch" Cursor="Hand" />
              </Grid>
            </Grid>
          </Border>
          <TextBlock Name="PreviewInfoText" Grid.Row="2" HorizontalAlignment="Center" Foreground="#94A3B8" Margin="0,10,0,0" Text="Trang 1 / 1" />
        </Grid>
      </Border>

      <!-- Settings Column 1: Print Range and Handling -->
      <Border Grid.Column="1" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="Phạm vi in" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC" Margin="0,0,0,8" />
            <RadioButton Name="CurrentViewRadio" Content="Vùng đang xem" Margin="0,0,0,7" />
            <RadioButton Name="CurrentPageRadio" Content="Trang hiện tại" Margin="0,0,0,7" />
            <RadioButton Name="AllPagesRadio" Content="Tất cả trang" IsChecked="True" Margin="0,0,0,7" />
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <RadioButton Grid.Column="0"
                            Name="CustomPagesRadio"
                            Content="Trang:"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                        Name="PageRangeTextBox"
                        Style="{StaticResource ModernTextBox}"
                        Height="26"
                        MinWidth="100"
                        TextChanged="PageRangeTextBox_TextChanged"/>

                <TextBlock Grid.Column="2"
                          Name="PageCountText"
                          Text="/21"
                          VerticalAlignment="Center"
                          Foreground="#94A3B8"
                          Margin="8,0,0,0"/>
            </Grid>
            <TextBlock Text="Ví dụ: 1, 5-12" Foreground="#64748B" Margin="22,-8,0,14" />

            <Separator Height="1" Background="#1E293B" Margin="0,4,0,12" />

            <TextBlock Text="Xử lý trang" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC" Margin="0,0,0,8" />
            <RadioButton Name="FitMarginsRadio" Content="Vừa vùng in của máy" IsChecked="True" Margin="0,0,0,7" />
            <RadioButton Name="ActualSizeRadio" Content="Giữ kích thước thật" IsEnabled="True" Margin="0,0,0,7" />
            <CheckBox Name="AutoCenterCheckBox" Content="Tự căn giữa" IsChecked="True" Margin="0,0,0,12" />

            <Separator Height="1" Background="#1E293B" Margin="0,4,0,12" />

            <TextBlock Text="Chế độ bù tọa độ in (Offset)" FontWeight="SemiBold" FontSize="14" Foreground="#F8FAFC" Margin="0,0,0,8" />
            <ComboBox Name="PrintOffsetModeComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0" Margin="0,0,0,6">
              <ComboBoxItem Content="Tự động nhận diện (Auto)" Tag="Auto" />
              <ComboBoxItem Content="Bù tọa độ WPF (WPF Offset)" Tag="WpfOffset" />
              <ComboBoxItem Content="Giữ tọa độ vật lý (Physical)" Tag="Physical" />
            </ComboBox>
            <CheckBox Name="TestFrameCheckBox" Content="In trang test viền" IsChecked="False" Margin="0,6,0,0" />
            <TextBlock Text="Bỏ nội dung PDF, in khung viền để kiểm tra mép bị cắt." Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="22,2,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Settings Column 2: Engine, Order, Layouts -->
      <StackPanel Grid.Column="2">
        <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="Chế độ in" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,8" />
              <ComboBox Name="PrintEngineComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
               <ComboBoxItem Content="Native PDFium (Tốc độ cao, siêu nét)" Tag="NativePdfium_Optimized" />
               <ComboBoxItem Content="WPF Bitmap (Tương thích cao)" Tag="WpfBitmap" />
               <ComboBoxItem Content="In trực tiếp PDF (Siêu nhanh - cần máy hỗ trợ)" Tag="PdfDirect_Optimized" />
             </ComboBox>
            <CheckBox Name="NativeSeparateJobsCheckBox" Content="Native: gửi từng trang" IsChecked="False" Margin="0,8,0,0" />
            <CheckBox Name="OptimizeCadCheckBox" Content="Tối ưu bản vẽ CAD/Revit" IsChecked="False" Margin="0,8,0,0" />
            <TextBlock Text="Chuyển vector thành ảnh phẳng (Dùng khi máy in bị treo/lỗi xử lý vector)." Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="18,2,0,0" />
          </StackPanel>
        </Border>
        <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="Thứ tự in" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,8" />
            <ComboBox Name="PrintOrderComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0">
              <ComboBoxItem Content="Máy in trắng đen" Tag="Forward" />
              <ComboBoxItem Content="Máy in màu" Tag="Reverse" />
            </ComboBox>
          </StackPanel>
        </Border>
        <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="Khổ giấy" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,8" />
            <ComboBox Name="PaperSizeComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0" SelectionChanged="PrintPreviewSettings_SelectionChanged">
              <ComboBoxItem Content="Theo máy in" Tag="Default" />
              <ComboBoxItem Content="A4" Tag="A4" />
              <ComboBoxItem Content="A3" Tag="A3" />
              <ComboBoxItem Content="A2" Tag="A2" />
              <ComboBoxItem Content="A1" Tag="A1" />
              <ComboBoxItem Content="A0" Tag="A0" />
              <ComboBoxItem Content="Letter" Tag="Letter" />
            </ComboBox>
          </StackPanel>
        </Border>
        <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock Text="Hướng giấy" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,8" />
            <ComboBox Name="OrientationComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="0" SelectionChanged="PrintPreviewSettings_SelectionChanged">
              <ComboBoxItem Content="Theo máy in" Tag="Default" />
              <ComboBoxItem Content="Dọc" Tag="Portrait" />
              <ComboBoxItem Content="Ngang" Tag="Landscape" />
            </ComboBox>
          </StackPanel>
        </Border>
        <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12">
          <StackPanel>
            <TextBlock Text="Chất lượng" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,0,8" />
            <ComboBox Name="QualityComboBox" Style="{StaticResource ModernComboBox}" SelectedIndex="2">
              <ComboBoxItem Content="Nhanh (300 DPI)" Tag="300" />
              <ComboBoxItem Content="Nét - khuyên dùng (400 DPI)" Tag="400" />
              <ComboBoxItem Content="Rất nét - chậm (600 DPI)" Tag="600" />
              <ComboBoxItem Content="Siêu nét - rất chậm (1200 DPI)" Tag="1200" />
            </ComboBox>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Bottom Area: Validation and Actions -->
    <Grid Row="2" Margin="0,10,0,0">
      <TextBlock Name="ValidationText" Foreground="#EF4444" VerticalAlignment="Center" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="In" Style="{StaticResource PremiumButton}" Width="110" Margin="0,0,12,0" IsDefault="True" Click="Ok_Click" />
        <Button Content="Hủy" Style="{StaticResource SecondaryButton}" Width="90" IsCancel="True" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
