<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PdfViewerApp.SplitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tách file PDF"
        Height="620" Width="720"
        MinHeight="560" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        xmlns:pdfviewerapp="clr-namespace:PdfViewerApp;assembly=PdfViewerApp">
  <Window.Resources>
    <ResourceDictionary>
      <!-- Premium button with gradient -->
      <Style x:Key="PremiumButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Border" CornerRadius="6" Padding="12,8">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F766E" Offset="0.0" />
                    <GradientStop Color="#14B8A6" Offset="1.0" />
                  </LinearGradientBrush>
                </Border.Background>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="UIElement.Opacity" Value="0.9" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Border" Property="UIElement.Opacity" Value="0.8" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- Secondary button -->
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#94A3B8" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Border" CornerRadius="6" BorderThickness="1.5" BorderBrush="#334155" Background="#1E293B" Padding="10,6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Border.BorderBrush" Value="#475569" />
                  <Setter Property="Foreground" Value="#F8FAFC" />
                  <Setter TargetName="Border" Property="Border.Background" Value="#334155" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Border" Property="Border.Background" Value="#0F172A" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- Modern TextBox styling -->
      <Style x:Key="ModernTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="#1E293B" />
        <Setter Property="Foreground" Value="#F8FAFC" />
        <Setter Property="BorderBrush" Value="#334155" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                <ScrollViewer Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="BorderBrush" Value="#475569" />
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                  <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8" />
                  <Setter Property="Background" Value="#0F172A" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- Modern ProgressBar -->
      <Style x:Key="ModernProgressBar" TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="#38BDF8" />
        <Setter Property="Background" Value="#1E293B" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ProgressBar}">
              <Grid Name="TemplateRoot">
                <Border CornerRadius="6" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" />
                <Border Name="PART_Indicator" CornerRadius="6" HorizontalAlignment="Left" Background="{TemplateBinding Control.Foreground}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="#F8FAFC" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="#F8FAFC" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,6" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    
    <!-- Title -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="Tách &amp; Trích xuất file PDF" FontSize="20" FontWeight="SemiBold" Foreground="#F8FAFC" />
      <TextBlock Text="Chọn chế độ và cấu hình các dải trang để phân chia tài liệu PDF nguồn thành các file PDF nhỏ hơn." Margin="0,4,0,14" TextWrapping="Wrap" Foreground="#94A3B8" />
    </StackPanel>

    <!-- Source File Selection -->
    <Border Grid.Row="1" Background="#111827" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="8" Padding="14" Margin="0,0,0,16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Tệp tin PDF nguồn:" Foreground="#F8FAFC" FontWeight="Medium" Margin="0,0,0,6" />
        <TextBox Name="SourceFileTextBox" Grid.Row="1" Grid.Column="0" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Margin="0,0,10,0" />
        <Button Name="SelectSourceFileBtn" Grid.Row="1" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Chọn file" Width="100" Click="SelectSourceFile_Click" />
      </Grid>
    </Border>

    <!-- Split Options Panel -->
    <Border Grid.Row="2" Background="#111827" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="8" Padding="16" Margin="0,0,0,16">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Chọn chế độ tách file:" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />
          
          <!-- Mode 1: Range extract -->
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RadioButton Name="ModeRangeRadio" Content="Trích xuất dải trang cụ thể:" IsChecked="True" Checked="ModeRadio_Checked" />
            <TextBox Name="RangeTextBox" Grid.Column="1" Style="{StaticResource ModernTextBox}" ToolTip="Ví dụ: 1-5 hoặc 1,3,5-7" />
          </Grid>

          <!-- Mode 2: Split every N pages -->
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RadioButton Name="ModeEveryNRadio" Content="Tách mỗi N trang thành 1 file:" Checked="ModeRadio_Checked" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <TextBox Name="EveryNTextBox" Width="80" Style="{StaticResource ModernTextBox}" Text="1" HorizontalContentAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBlock Text="trang / file" Foreground="#94A3B8" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>

          <!-- Mode 3: Single pages -->
          <RadioButton Name="ModeSingleRadio" Content="Tách tất cả các trang đơn lẻ (mỗi trang 1 file)" Checked="ModeRadio_Checked" Margin="0,0,0,16" />

          <!-- Mode 4: Custom groups -->
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RadioButton Name="ModeGroupsRadio" Content="Tách theo các nhóm trang tùy ý:" Checked="ModeRadio_Checked" />
            <TextBox Name="GroupsTextBox" Grid.Column="1" Style="{StaticResource ModernTextBox}" ToolTip="Ngăn cách các nhóm bằng dấu chấm phẩy, ví dụ: 1-3; 4-6; 7-10" />
          </Grid>

          <!-- Output Folder Selection -->
          <Separator Background="#334155" Margin="0,14,0,14" />
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Thư mục lưu kết quả:" Foreground="#F8FAFC" FontWeight="Medium" Margin="0,0,0,6" />
            <TextBox Name="OutputFolderTextBox" Grid.Row="1" Grid.Column="0" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Margin="0,0,10,0" />
            <Button Name="SelectOutputFolderBtn" Grid.Row="1" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Chọn thư mục" Width="100" Click="SelectOutputFolder_Click" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Progress panel -->
    <StackPanel Grid.Row="3" Margin="0,0,0,14">
      <ProgressBar Name="SplitProgress" Style="{StaticResource ModernProgressBar}" Visibility="Collapsed" Minimum="0" Maximum="1" Value="0" />
      <TextBlock Name="ProgressText" Margin="0,6,0,0" Foreground="#94A3B8" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Footer Actions -->
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Name="StatusText" VerticalAlignment="Center" Foreground="#94A3B8" TextWrapping="Wrap" Text="Sẵn sàng" />
      <Button Name="CancelButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,10,0" Click="Cancel_Click" Content="Hủy" />
      <Button Name="SplitButton" Grid.Column="2" Style="{StaticResource PremiumButton}" Width="140" Click="Split_Click" Content="Bắt đầu tách" />
    </Grid>
  </Grid>
</Window>
