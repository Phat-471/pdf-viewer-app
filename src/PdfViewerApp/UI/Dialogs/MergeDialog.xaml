<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PdfViewerApp.MergeDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Gộp file PDF" Height="560" Width="760" MinHeight="500" MinWidth="680" WindowStartupLocation="CenterOwner" Background="#0F172A" AllowDrop="True" xmlns:pdfviewerapp="clr-namespace:PdfViewerApp;assembly=PdfViewerApp" Drop="Window_Drop">
  <Window.Resources>
    <ResourceDictionary>
      <Style x:Key="PremiumButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Border" CornerRadius="6" Padding="12,8">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F766E" Offset="0.0" />
                    <GradientStop Color="#14B8A6" Offset="1.0" />
                  </LinearGradientBrush>
                </Border.Background>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="UIElement.Opacity" Value="0.9" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Border" Property="UIElement.Opacity" Value="0.8" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#94A3B8" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Border" CornerRadius="6" BorderThickness="1.5" BorderBrush="#334155" Background="#1E293B" Padding="10,6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Border.BorderBrush" Value="#475569" />
                  <Setter Property="Foreground" Value="#F8FAFC" />
                  <Setter TargetName="Border" Property="Border.Background" Value="#334155" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Border" Property="Border.Background" Value="#0F172A" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DangerButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#EF4444" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Border" CornerRadius="6" BorderThickness="1.5" BorderBrush="#991B1B" Background="#1A0F0F" Padding="10,6">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Border.Background" Value="#2D1414" />
                  <Setter Property="Foreground" Value="#FCA5A5" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Border" Property="Border.Background" Value="#451A1A" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ModernProgressBar" TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="#38BDF8" />
        <Setter Property="Background" Value="#1E293B" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ProgressBar}">
              <Grid Name="TemplateRoot">
                <Border CornerRadius="6" Background="{TemplateBinding Control.Background}" BorderThickness="{TemplateBinding Control.BorderThickness}" />
                <Border Name="PART_Indicator" CornerRadius="6" HorizontalAlignment="Left" Background="{TemplateBinding Control.Foreground}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="#111827" />
        <Setter Property="Foreground" Value="#F8FAFC" />
        <Setter Property="BorderBrush" Value="#334155" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBox}">
              <Border Name="Border" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#CBD5E1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="Border" CornerRadius="6" Margin="4,2" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Background" Value="#1E293B" />
                  <Setter Property="Foreground" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Border" Property="Background" Value="#0F766E" />
                  <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="#F8FAFC" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="Gộp nhiều file PDF" FontSize="20" FontWeight="SemiBold" Foreground="#F8FAFC" />
      <TextBlock Text="Kéo thả file từ Explorer hoặc bấm Thêm file. Các file được thêm sẽ được sắp xếp theo tên để tránh sai thứ tự bản vẽ." Margin="0,6,0,12" TextWrapping="Wrap" Foreground="#94A3B8" />
    </StackPanel>
    <Border Grid.Row="1" Background="#111827" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
      <DockPanel LastChildFill="True">
        <CheckBox Name="AutoSortCheckBox" Content="Tự động sắp xếp theo tên trước khi gộp" IsChecked="True" VerticalAlignment="Center" Checked="AutoSortCheckBox_Changed" Unchecked="AutoSortCheckBox_Changed" />
        <TextBlock Name="DetailsText" DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="#94A3B8" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Grid Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="124" />
      </Grid.ColumnDefinitions>
      <ListBox Name="FileListBox" Margin="0,0,12,0" SelectionMode="Single" DisplayMemberPath="DisplayName" AllowDrop="True" Drop="Window_Drop" />
      <StackPanel Grid.Column="1">
        <Button Name="AddFileButton" Style="{StaticResource PremiumButton}" Margin="0,0,0,8" Click="AddFile_Click">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Thêm file" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="MoveUpButton" Style="{StaticResource SecondaryButton}" Margin="0,0,0,6" Click="MoveUp_Click">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Lên" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="MoveDownButton" Style="{StaticResource SecondaryButton}" Margin="0,0,0,14" Click="MoveDown_Click">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Xuống" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="RemoveButton" Style="{StaticResource DangerButton}" Margin="0,0,0,6" Click="Remove_Click">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Xóa" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="ClearButton" Style="{StaticResource DangerButton}" Click="Clear_Click">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="Xóa tất cả" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,14,0,12">
      <ProgressBar Name="MergeProgress" Style="{StaticResource ModernProgressBar}" Visibility="Collapsed" Minimum="0" Maximum="1" Value="0" />
      <TextBlock Name="ProgressText" Margin="0,6,0,0" Foreground="#94A3B8" TextWrapping="Wrap" />
    </StackPanel>
    <Grid Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Name="StatusText" VerticalAlignment="Center" Foreground="#94A3B8" TextWrapping="Wrap" />
      <Button Name="CancelButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,10,0" Click="Cancel_Click">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Text="Hủy" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Name="MergeButton" Grid.Column="2" Style="{StaticResource PremiumButton}" Width="140" Click="Merge_Click">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Text="Bắt đầu gộp" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</Window>