<Window x:Class="PdfViewerApp.ExtractImagesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trích Xuất Hình Ảnh" Height="300" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A">
    <Window.Resources>
        <!-- Custom Styles for Premium UI -->
        <Style TargetType="Button" x:Key="ModernButton">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" CornerRadius="6" BorderThickness="1.5" BorderBrush="#334155" Background="#1E293B" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#475569" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                                <Setter TargetName="Border" Property="Background" Value="#334155" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="ModernTextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ScrollViewer Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="#38BDF8" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Name="TemplateRoot">
                            <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" />
                            <Border Name="PART_Indicator" CornerRadius="6" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="TRÍCH XUẤT HÌNH ẢNH TỪ PDF" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Tìm và xuất toàn bộ hình ảnh chứa trong tệp PDF này ra thư mục." Foreground="#94A3B8" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Content Panel -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="15" BorderBrush="#334155" BorderThickness="1">
            <StackPanel>
                <!-- Output Folder Selection -->
                <TextBlock Text="Thư mục lưu hình ảnh trích xuất:" Foreground="#F8FAFC" FontWeight="Medium" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputFolderTextBox" Style="{StaticResource ModernTextBox}" IsReadOnly="True" Margin="0,0,10,0" Height="32"/>
                    <Button Name="BrowseBtn" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Chọn Thư Mục" Width="110" Click="Browse_Click" Height="32"/>
                </Grid>

                <!-- Progress Bar -->
                <ProgressBar x:Name="ExtractProgressBar" Style="{StaticResource ModernProgressBar}" IsIndeterminate="False" Visibility="Collapsed" Height="10" Margin="0,5,0,5"/>
            </StackPanel>
        </Border>

        <!-- Action Buttons -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Name="StatusTextBlock" Text="Sẵn sàng trích xuất." Foreground="#94A3B8" VerticalAlignment="Center" TextWrapping="Wrap" Grid.Column="0" Margin="0,0,10,0"/>

            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                <Button Name="CancelBtn" Style="{StaticResource ModernButton}" Content="Hủy" Click="Cancel_Click" Background="#475569" Margin="0,0,8,0"/>
                <Button Name="ExtractBtn" Style="{StaticResource ModernButton}" Content="Trích Xuất" Click="Extract_Click" Background="#0EA5E9"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
