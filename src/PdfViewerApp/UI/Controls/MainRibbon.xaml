      <fluent:RibbonGroupBox Header="Chụp ảnh &amp; AI" Tag="Ocr">
        <fluent:ToggleButton Name="SnapshotToolBtn" Header="Snapshot" LargeIcon="{StaticResource IconSnapshot}" Size="Large" Margin="3,0" Click="SnapshotTool_Click" ToolTip="Kéo chọn vùng → xem trước → in, copy hoặc lưu ảnh" />
        <fluent:ToggleButton Name="AiSnapshotBtn" Header="AI Snapshot" LargeIcon="{StaticResource IconAiSnapshot}" Margin="3,0" Click="AiSnapshotTool_Click" ToolTip="Chụp một vùng trên tài liệu để gửi cho trợ lý AI phân tích, dịch thuật" />
      </fluent:RibbonGroupBox>
      <fluent:RibbonGroupBox Header="Tùy chọn" Tag="Utilities" Visibility="Collapsed">
        <fluent:CheckBox Name="KeepToolsActiveCheckBox" Header="Sử dụng liên tục" Click="KeepToolsActiveCheckBox_Click" ToolTip="Giữ các công cụ vẽ, chú thích, chụp ảnh hoạt động liên tục cho đến khi nhấn ESC" IsChecked="False" />
      </fluent:RibbonGroupBox>
    </fluent:RibbonTabItem>

    <fluent:RibbonTabItem Header="Xem">
      <fluent:RibbonGroupBox Header="Hiển thị trang" Tag="Navigation">
        <fluent:Button Name="ViewActualSizeBtn" Header="100%" LargeIcon="{StaticResource IconFit}" Size="Large" Click="ActualSize_Click" ToolTip="Hiển thị theo kích thước thực tế 100% (Ctrl+1)" />
        <fluent:Button Name="ViewFitPageBtn" Header="Vừa trang" LargeIcon="{StaticResource IconFit}" Size="Large" Click="FitPage_Click" ToolTip="Hiển thị toàn bộ trang PDF trong vùng xem (Ctrl+0)." />
        <fluent:Button Name="ViewFitWidthBtn" Header="Vừa rộng" LargeIcon="{StaticResource IconFit}" Size="Large" Click="FitWidth_Click" ToolTip="Điều chỉnh trang theo chiều rộng vùng xem (Ctrl+2)." />
      </fluent:RibbonGroupBox>
      <fluent:RibbonGroupBox Header="Thu phóng &amp; Bảng điều khiển" Tag="Navigation">
        <fluent:Button Name="ViewZoomOutBtn" Header="Thu nhỏ" LargeIcon="{StaticResource IconZoomOut}" Size="Large" Click="ZoomOut_Click" />
        <fluent:Button Name="ViewZoomInBtn" Header="Phóng to" LargeIcon="{StaticResource IconZoomIn}" Size="Large" Click="ZoomIn_Click" />
        <fluent:Button Name="ViewSidebarBtn" Header="Thanh trang" LargeIcon="{StaticResource IconSidebar}" Size="Large" Click="ToggleSidebar_Click" ToolTip="Hiện hoặc ẩn danh sách trang." />
      </fluent:RibbonGroupBox>
    </fluent:RibbonTabItem>

    <fluent:RibbonTabItem Header="Trợ giúp">
      <fluent:RibbonGroupBox Header="Giao diện" Tag="Utilities">
        <fluent:ToggleButton Name="ThemeToggleBtn" Header="Chủ đề" MinWidth="52" Margin="3,0" IsChecked="False" Click="ThemeToggle_Click" ToolTip="Chuyển đổi giao diện sáng / tối">
          <fluent:ToggleButton.LargeIcon>
            <Border Name="ThemeIconBadge" Width="20" Height="20" CornerRadius="4"
                    Background="#FFFFFF" BorderBrush="#F59E0B" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Name="ThemeToggleIcon" Tag="ThemeToggleIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE706;" FontSize="13"
                         Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </fluent:ToggleButton.LargeIcon>
        </fluent:ToggleButton>
        <fluent:Button Header="Cài đặt" LargeIcon="{StaticResource IconSetting}" MinWidth="52" Margin="3,0" Click="Settings_Click" ToolTip="Cài đặt cấu hình hệ thống" />
      </fluent:RibbonGroupBox>
      <fluent:RibbonGroupBox Header="Trợ lý AI" Tag="Ocr">
        <fluent:Button Header="Gemini API" MinWidth="56" Size="Large" Click="OpenGeminiApiKey_Click" ToolTip="Mở trang quản lý khóa API Gemini.">
          <fluent:Button.LargeIcon>
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEA86;" FontSize="19" Foreground="#7C3AED" Tag="ColorLocked" HorizontalAlignment="Center" />
          </fluent:Button.LargeIcon>
        </fluent:Button>
        <fluent:Button Header="OpenAI API" MinWidth="56" Size="Large" Click="OpenOpenAiApiKey_Click" ToolTip="Mở trang quản lý khóa API OpenAI.">
          <fluent:Button.LargeIcon>
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEBD2;" FontSize="19" Foreground="#10B981" Tag="ColorLocked" HorizontalAlignment="Center" />
          </fluent:Button.LargeIcon>
        </fluent:Button>
        <fluent:Button Header="Tải Ollama" MinWidth="56" Size="Large" Click="OpenOllamaDownload_Click" ToolTip="Mở trang tải Ollama để thiết lập mô hình AI cục bộ.">
          <fluent:Button.LargeIcon>
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="19" Foreground="#EA580C" Tag="ColorLocked" HorizontalAlignment="Center" />
          </fluent:Button.LargeIcon>
        </fluent:Button>
        <fluent:Button Header="Kiểm tra" MinWidth="56" Size="Large" Click="CheckLibraries_Click" ToolTip="Kiểm tra các thành phần và thư viện ứng dụng.">
          <fluent:Button.LargeIcon>
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D5;" FontSize="19" Foreground="#0284C7" Tag="ColorLocked" HorizontalAlignment="Center" />
          </fluent:Button.LargeIcon>
        </fluent:Button>
      </fluent:RibbonGroupBox>
      <fluent:RibbonGroupBox Header="Trợ giúp &amp; Bản quyền" Tag="Utilities">
        <fluent:Button Header="Hướng dẫn" MinWidth="52" Margin="3,0" Click="UserGuide_Click" ToolTip="Xem hướng dẫn sử dụng chi tiết các tính năng của phần mềm">
          <fluent:Button.LargeIcon>
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE82D;" FontSize="19" Foreground="#2563EB" Tag="ColorLocked" HorizontalAlignment="Center" />
          </fluent:Button.LargeIcon>
        </fluent:Button>
        <fluent:Button Header="Phản hồi" MinWidth="52" Margin="3,0" Click="Feedback_Click" ToolTip="Gửi ý kiến đóng góp hoặc báo cáo lỗi trực tiếp đến nhà phát triển">
          <fluent:Button.LargeIcon>
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xED15;" FontSize="19" Foreground="#8B5CF6" Tag="ColorLocked" HorizontalAlignment="Center" />
          </fluent:Button.LargeIcon>
        </fluent:Button>
        <fluent:Button Header="Cài máy in" MinWidth="54" Margin="3,0" Click="VirtualPrinterConfig_Click" ToolTip="Cấu hình hoặc cài đặt trình điều khiển máy in ảo của ứng dụng">
          <fluent:Button.LargeIcon>
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE749;" FontSize="19" Foreground="#0D9488" Tag="ColorLocked" HorizontalAlignment="Center" />
          </fluent:Button.LargeIcon>
        </fluent:Button>
        <fluent:Button Header="Cập nhật" MinWidth="52" Margin="3,0" Click="ManualUpdateCheck_Click" ToolTip="Kiểm tra xem có bản cập nhật mới nhất cho ứng dụng không">
          <fluent:Button.LargeIcon>
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE895;" FontSize="19" Foreground="#059669" Tag="ColorLocked" HorizontalAlignment="Center" />
          </fluent:Button.LargeIcon>
        </fluent:Button>
        <fluent:Button Header="Chẩn đoán" MinWidth="54" Margin="3,0" Click="ShowPdfDiagnostics_Click" ToolTip="Xem chẩn đoán chi tiết và phân tích hiệu năng của tài liệu PDF">
          <fluent:Button.LargeIcon>
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="19" Foreground="#D97706" Tag="ColorLocked" HorizontalAlignment="Center" />
          </fluent:Button.LargeIcon>
        </fluent:Button>
        <fluent:Button Header="Khôi phục" MinWidth="52" Margin="3,0" Click="RestorePreviousVersion_Click" ToolTip="Khôi phục về phiên bản trước đó nếu gặp lỗi sau khi cập nhật">
          <fluent:Button.LargeIcon>
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE777;" FontSize="19" Foreground="#64748B" Tag="ColorLocked" HorizontalAlignment="Center" />
          </fluent:Button.LargeIcon>
        </fluent:Button>
        <fluent:Button Header="Kích hoạt" MinWidth="52" Margin="3,0" Click="Activation_Click" ToolTip="Nhập mã bản quyền để kích hoạt toàn bộ tính năng cao cấp của phần mềm">
          <fluent:Button.LargeIcon>
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D7;" FontSize="19" Foreground="#D97706" Tag="ColorLocked" HorizontalAlignment="Center" />
          </fluent:Button.LargeIcon>
        </fluent:Button>
        <fluent:Button Header="Giới thiệu" MinWidth="52" Margin="3,0" Click="About_Click" ToolTip="Xem thông tin phiên bản phần mềm, bản quyền và nhà cung cấp">
          <fluent:Button.LargeIcon>
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="19" Foreground="#0284C7" Tag="ColorLocked" HorizontalAlignment="Center" />
          </fluent:Button.LargeIcon>
        </fluent:Button>
      </fluent:RibbonGroupBox>
    </fluent:RibbonTabItem>
    <fluent:RibbonTabItem Header="Định dạng" Group="{Binding ElementName=CommentFormatGroup}" x:Name="CommentFormatTab">
      <fluent:RibbonGroupBox Header="Phông chữ chú thích" Tag="Comments">
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="4,2,4,2">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <fluent:ComboBox Name="FontFamilyCombo" Width="120" Height="22" SelectedIndex="1" Margin="0,0,4,0" SelectionChanged="FontFamilyCombo_SelectionChanged" ToolTip="Chọn phông chữ cho hộp chú thích văn bản">
              <ComboBoxItem Content="Calibri" Tag="Calibri" />
              <ComboBoxItem Content="Segoe UI" Tag="Segoe UI" />
              <ComboBoxItem Content="Arial" Tag="Arial" />
              <ComboBoxItem Content="Times New Roman" Tag="Times New Roman" />
              <ComboBoxItem Content="Courier New" Tag="Courier New" />
            </fluent:ComboBox>
            <fluent:ComboBox Name="FontSizeCombo" Width="50" Height="22" SelectedIndex="3" Margin="0,0,4,0" SelectionChanged="FontSizeCombo_SelectionChanged" ToolTip="Chọn kích thước phông chữ chú thích">
              <ComboBoxItem Content="9" Tag="9" />
              <ComboBoxItem Content="11" Tag="11" />
              <ComboBoxItem Content="12" Tag="12" />
              <ComboBoxItem Content="14" Tag="14" />
              <ComboBoxItem Content="16" Tag="16" />
              <ComboBoxItem Content="18" Tag="18" />
              <ComboBoxItem Content="24" Tag="24" />
              <ComboBoxItem Content="36" Tag="36" />
              <ComboBoxItem Content="48" Tag="48" />
            </fluent:ComboBox>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <ToggleButton Name="BoldToggle" Content="B" FontWeight="Bold" Width="22" Height="22" Style="{StaticResource ThemeToggleButtonStyle}" Click="BoldToggle_Click" ToolTip="Định dạng chữ in đậm" />
            <ToggleButton Name="ItalicToggle" Content="I" FontStyle="Italic" Width="22" Height="22" Margin="4,0,0,0" Style="{StaticResource ThemeToggleButtonStyle}" Click="ItalicToggle_Click" ToolTip="Định dạng chữ in nghiêng" />
            <ToggleButton Name="UnderlineToggle" Content="U" Width="22" Height="22" Margin="4,0,0,0" Style="{StaticResource ThemeToggleButtonStyle}" Click="UnderlineToggle_Click" ToolTip="Định dạng chữ gạch chân" />
            <ToggleButton Name="StrikeToggle" Content="S" Width="22" Height="22" Margin="4,0,0,0" Style="{StaticResource ThemeToggleButtonStyle}" Click="StrikeToggle_Click" ToolTip="Định dạng chữ gạch ngang" />
            <ToggleButton Name="SubscriptToggle" Content="x₂" Width="22" Height="22" Margin="4,0,0,0" Style="{StaticResource ThemeToggleButtonStyle}" Click="SubscriptToggle_Click" ToolTip="Chỉ số dưới" />
            <ToggleButton Name="SuperscriptToggle" Content="x²" Width="22" Height="22" Margin="4,0,0,0" Style="{StaticResource ThemeToggleButtonStyle}" Click="SuperscriptToggle_Click" ToolTip="Chỉ số trên" />
          </StackPanel>
        </StackPanel>
      </fluent:RibbonGroupBox>
      <fluent:RibbonGroupBox Header="Paragraph" Tag="Comments">
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="4,2,4,2">
          <StackPanel Orientation="Horizontal">
            <ToggleButton Name="AlignLeftToggle" Width="22" Height="22" Style="{StaticResource ThemeToggleButtonStyle}" Click="AlignLeftToggle_Click" ToolTip="Căn lề trái">
              <ToggleButton.Content>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A4;" FontSize="9.5" />
              </ToggleButton.Content>
            </ToggleButton>
            <ToggleButton Name="AlignCenterToggle" Width="22" Height="22" Margin="4,0,0,0" Style="{StaticResource ThemeToggleButtonStyle}" Click="AlignCenterToggle_Click" ToolTip="Căn lề giữa">
              <ToggleButton.Content>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A3;" FontSize="9.5" />
              </ToggleButton.Content>
            </ToggleButton>
            <ToggleButton Name="AlignRightToggle" Width="22" Height="22" Margin="4,0,0,0" Style="{StaticResource ThemeToggleButtonStyle}" Click="AlignRightToggle_Click" ToolTip="Căn lề phải">
              <ToggleButton.Content>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A2;" FontSize="9.5" />
              </ToggleButton.Content>
            </ToggleButton>
            <ToggleButton Name="AlignJustifyToggle" Width="22" Height="22" Margin="4,0,0,0" Style="{StaticResource ThemeToggleButtonStyle}" Click="AlignJustifyToggle_Click" ToolTip="Căn lề đều hai bên">
              <ToggleButton.Content>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8F7;" FontSize="9.5" />
              </ToggleButton.Content>
            </ToggleButton>
            <fluent:Button Name="BulletListBtn" Width="22" Height="22" Margin="10,0,0,0" Click="BulletListBtn_Click" ToolTip="Tạo danh sách dấu đầu dòng">
              <fluent:Button.Icon>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" FontSize="9.5" />
              </fluent:Button.Icon>
            </fluent:Button>
            <fluent:Button Name="NumberListBtn" Width="22" Height="22" Margin="4,0,0,0" Click="NumberListBtn_Click" ToolTip="Tạo danh sách đánh số">
              <fluent:Button.Icon>
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xF14A;" FontSize="9.5" />
              </fluent:Button.Icon>
            </fluent:Button>
          </StackPanel>
        </StackPanel>
      </fluent:RibbonGroupBox>
      <fluent:RibbonGroupBox Header="Kiểu viền &amp; nền" Tag="Comments">
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="4,2,4,2">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <fluent:ComboBox Name="StrokeColorCombo" Width="110" Height="22" SelectedIndex="0" Margin="0,0,6,0" SelectionChanged="StrokeColorCombo_SelectionChanged" ToolTip="Chọn màu viền/màu vẽ của nét chú thích">
              <ComboBoxItem Content="Đỏ (Red)" Tag="Red" />
              <ComboBoxItem Content="Xanh Dương" Tag="Blue" />
              <ComboBoxItem Content="Xanh Lá" Tag="Green" />
              <ComboBoxItem Content="Đen" Tag="Black" />
              <ComboBoxItem Content="Vàng" Tag="Yellow" />
            </fluent:ComboBox>
            <fluent:ComboBox Name="BgColorCombo" Width="110" Height="22" SelectedIndex="0" SelectionChanged="BgColorCombo_SelectionChanged" ToolTip="Chọn màu sắc nền lấp đầy bên trong hình vẽ chú thích">
              <ComboBoxItem Content="Trong Suốt" Tag="Transparent" />
              <ComboBoxItem Content="Trắng" Tag="White" />
              <ComboBoxItem Content="Vàng Nhạt" Tag="LightYellow" />
              <ComboBoxItem Content="Đỏ Nhạt" Tag="MistyRose" />
              <ComboBoxItem Content="Xanh Nhạt" Tag="AliceBlue" />
            </fluent:ComboBox>
          </StackPanel>
          <fluent:Spinner Name="OpacitySpinner" Minimum="10" Maximum="100" Value="100" Height="22" Width="120" HorizontalAlignment="Left" ValueChanged="OpacitySpinner_ValueChanged" ToolTip="Điều chỉnh độ mờ đục/trong suốt của đối tượng vẽ hoặc nền hộp chú thích (10% - 100%)" />
        </StackPanel>
      </fluent:RibbonGroupBox>
    </fluent:RibbonTabItem>
  </fluent:Ribbon>
</UserControl>
