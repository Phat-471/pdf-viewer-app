<UserControl x:Class="PdfViewerApp.MainRibbon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="urn:fluent-ribbon"
             Background="#00FFFFFF">
  <UserControl.Resources>
    <!-- Shared ribbon surfaces; ApplyTheme updates these tokens for every theme. -->
    <SolidColorBrush x:Key="RibbonButtonBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="RibbonGroupBackground" Color="#F1F5F9" />
    <SolidColorBrush x:Key="RibbonBorderBrush" Color="#B8C5D5" />
    <SolidColorBrush x:Key="RibbonTextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="RibbonAccentBrush" Color="#0F766E" />
    <SolidColorBrush x:Key="RibbonHoverBrush" Color="#E0F2F1" />
    <SolidColorBrush x:Key="RibbonSelectedBrush" Color="#CCFBF1" />
    <SolidColorBrush x:Key="RibbonGroupDocumentBrush" Color="#0F766E" />
    <SolidColorBrush x:Key="RibbonGroupNavigationBrush" Color="#0369A1" />
    <SolidColorBrush x:Key="RibbonGroupPagesBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="RibbonGroupCommentsBrush" Color="#B45309" />
    <SolidColorBrush x:Key="RibbonGroupMeasureBrush" Color="#7E22CE" />
    <SolidColorBrush x:Key="RibbonGroupOcrBrush" Color="#047857" />
    <SolidColorBrush x:Key="RibbonGroupUtilitiesBrush" Color="#475569" />
    <Style TargetType="fluent:Button" BasedOn="{StaticResource Fluent.Ribbon.Styles.Button}">
      <Setter Property="Background" Value="{DynamicResource RibbonButtonBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RibbonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource RibbonTextBrush}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Margin" Value="2,0" />
      <EventSetter Event="Loaded" Handler="RibbonFrame_Loaded" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource RibbonHoverBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource RibbonAccentBrush}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{DynamicResource RibbonSelectedBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource RibbonAccentBrush}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource RibbonAccentBrush}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="fluent:ToggleButton" BasedOn="{StaticResource Fluent.Ribbon.Styles.RibbonToggleButton}">
      <Setter Property="Background" Value="{DynamicResource RibbonButtonBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RibbonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource RibbonTextBrush}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Margin" Value="2,0" />
      <EventSetter Event="Loaded" Handler="RibbonFrame_Loaded" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource RibbonHoverBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource RibbonAccentBrush}" />
        </Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{DynamicResource RibbonSelectedBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource RibbonAccentBrush}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="{DynamicResource RibbonSelectedBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource RibbonAccentBrush}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource RibbonAccentBrush}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="fluent:SplitButton" BasedOn="{StaticResource Fluent.Ribbon.Styles.RibbonSplitButton}">
      <Setter Property="Background" Value="{DynamicResource RibbonButtonBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RibbonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource RibbonTextBrush}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Margin" Value="2,0" />
      <EventSetter Event="Loaded" Handler="RibbonFrame_Loaded" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource RibbonHoverBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource RibbonAccentBrush}" />
        </Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{DynamicResource RibbonSelectedBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource RibbonAccentBrush}" />
        </Trigger>
        <Trigger Property="IsDropDownOpen" Value="True">
          <Setter Property="Background" Value="{DynamicResource RibbonSelectedBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource RibbonAccentBrush}" />
        </Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource RibbonAccentBrush}" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="fluent:RibbonGroupBox" BasedOn="{StaticResource Fluent.Ribbon.Styles.RibbonGroupBox}">
      <Setter Property="Background" Value="{DynamicResource RibbonGroupBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RibbonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource RibbonAccentBrush}" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="IsSeparatorVisible" Value="False" />
      <Setter Property="HeaderTemplate">
        <Setter.Value>
          <DataTemplate>
            <Border BorderThickness="0,1,0,0" Padding="3,1,3,0"
                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=fluent:RibbonGroupBox}}">
              <TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold" TextAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=fluent:RibbonGroupBox}}"
                         TextTrimming="CharacterEllipsis" />
            </Border>
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <EventSetter Event="Loaded" Handler="RibbonFrame_Loaded" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="Document"><Setter Property="Foreground" Value="{DynamicResource RibbonGroupDocumentBrush}" /></Trigger>
        <Trigger Property="Tag" Value="Navigation"><Setter Property="Foreground" Value="{DynamicResource RibbonGroupNavigationBrush}" /></Trigger>
        <Trigger Property="Tag" Value="Pages"><Setter Property="Foreground" Value="{DynamicResource RibbonGroupPagesBrush}" /></Trigger>
        <Trigger Property="Tag" Value="Comments"><Setter Property="Foreground" Value="{DynamicResource RibbonGroupCommentsBrush}" /></Trigger>
        <Trigger Property="Tag" Value="Measure"><Setter Property="Foreground" Value="{DynamicResource RibbonGroupMeasureBrush}" /></Trigger>
        <Trigger Property="Tag" Value="Ocr"><Setter Property="Foreground" Value="{DynamicResource RibbonGroupOcrBrush}" /></Trigger>
        <Trigger Property="Tag" Value="Utilities"><Setter Property="Foreground" Value="{DynamicResource RibbonGroupUtilitiesBrush}" /></Trigger>
      </Style.Triggers>
    </Style>
