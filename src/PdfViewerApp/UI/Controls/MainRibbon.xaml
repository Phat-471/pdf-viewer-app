    <!-- Style for TextBlock to toggle Foreground between Black (Light Mode) and White (Dark Mode) -->
    <Style x:Key="ThemeTextBlockStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#0F172A" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
          <Setter Property="Foreground" Value="#FFFFFFFF" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Compact formatting buttons use the same surfaces and keyboard feedback. -->
    <Style x:Key="ThemeToggleButtonStyle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource RibbonTextBrush}" />
      <Setter Property="Background" Value="{DynamicResource RibbonButtonBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource RibbonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource RibbonHoverBrush}" /></Trigger>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{DynamicResource RibbonSelectedBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource RibbonAccentBrush}" />
        </Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource RibbonSelectedBrush}" /></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource RibbonAccentBrush}" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <fluent:Ribbon Name="MyRibbon" IsMinimized="False">
    <fluent:Ribbon.ContextualGroups>
      <fluent:RibbonContextualTabGroup x:Name="CommentFormatGroup" Header="Định dạng chú thích" Visibility="Collapsed" Background="#8B5CF6" BorderBrush="#8B5CF6"/>
    </fluent:Ribbon.ContextualGroups>
    <fluent:Ribbon.Style>
      <Style TargetType="fluent:Ribbon">
        <Setter Property="BorderThickness" Value="0,0,0,1" />
      </Style>
    </fluent:Ribbon.Style>
    <fluent:Ribbon.Menu>
      <fluent:Backstage x:Name="MyBackstage" Header="Tệp" Background="#0F766E" Foreground="#FFFFFFFF" WindowChrome.IsHitTestVisibleInChrome="True">
        <fluent:BackstageTabControl>
          <fluent:Button Header="Mở file PDF" Click="OpenPdf_Click" />
          <fluent:Button Header="Lưu" Click="SavePdf_Click" />
          <fluent:Button Header="Lưu dưới dạng..." Click="SavePdfAs_Click" />
          <fluent:Button Header="Tối ưu dung lượng" Click="CompressPdf_Click" />
          <fluent:Button Header="Thoát" Click="Exit_Click" />
        </fluent:BackstageTabControl>
      </fluent:Backstage>
    </fluent:Ribbon.Menu>
    <fluent:RibbonTabItem Header="Trang chủ">
      <fluent:RibbonGroupBox Header="Tệp" Tag="Document">
        <fluent:Button Header="Mở" LargeIcon="{StaticResource IconOpen}" Size="Large" Margin="2,0" Click="OpenPdf_Click" ToolTip="Mở PDF (Ctrl+O)" />
        <fluent:SplitButton Header="Lưu" LargeIcon="{StaticResource IconSave}" Size="Large" Margin="2,0" Click="SavePdf_Click" ToolTip="Lưu PDF (Ctrl+S)">
          <fluent:MenuItem Header="Lưu dưới dạng…" Click="SavePdfAs_Click" />
        </fluent:SplitButton>
        <fluent:SplitButton Header="In" LargeIcon="{StaticResource IconPrinter}" Size="Large" Margin="2,0" Click="PrintPdf_Click" ToolTip="In PDF (Ctrl+P)">
