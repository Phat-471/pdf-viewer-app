<Window x:Class="PdfViewerApp.PageOrganizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản Lý Trang PDF (Page Organizer)" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner" Background="#0F172A" Foreground="#F8FAFC"
        FontFamily="Segoe UI, Tahoma, Helvetica" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="OrganizerButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#334155" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="#475569" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryOrganizerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource OrganizerButton}">
            <Setter Property="Background" Value="#0F766E" />
            <Setter Property="BorderBrush" Value="#0D9488" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Control Bar -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Xoay Trái ↺" Style="{StaticResource OrganizerButton}" Click="RotateLeft_Click" Margin="0,0,8,0" />
                    <Button Content="Xoay Phải ↻" Style="{StaticResource OrganizerButton}" Click="RotateRight_Click" Margin="0,0,8,0" />
                    <Button Content="Xóa Trang 🗑" Style="{StaticResource OrganizerButton}" Click="DeletePage_Click" Margin="0,0,8,0" />
                    <Button Content="Chèn Trang Trắng ➕" Style="{StaticResource OrganizerButton}" Click="InsertBlank_Click" Margin="0,0,16,0" />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock VerticalAlignment="Center" Foreground="#94A3B8" Margin="0,0,12,0">
                        * Kéo thả các trang để đổi thứ tự. Nhấn Ctrl hoặc Shift để chọn nhiều trang.
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Thumbnail Grid -->
        <ListBox Grid.Row="1" Name="PagesListBox" Background="Transparent" BorderThickness="0" Margin="16"
                 SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Margin="10" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Margin" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Name="ItemBorder" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Background="#111827" Padding="8">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#0EA5E9" />
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1E293B" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1E293B" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="130" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Kéo để di chuyển">
                        <Border Width="120" Height="160" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border Background="#7F000000" VerticalAlignment="Top" HorizontalAlignment="Right" Padding="6,2" CornerRadius="0,0,0,4">
                                    <TextBlock Text="{Binding RotationAngle, StringFormat={}{0}°}" FontSize="10" Foreground="#F8FAFC" />
                                </Border>
                                <Border CornerRadius="4" Background="#CC0F172A" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="↺" Width="28" Height="22" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Click="QuickRotateLeft_Click" ToolTip="Xoay trái 90°" />
                                        <Button Content="↻" Width="28" Height="22" Background="Transparent" Foreground="White" BorderThickness="0" Cursor="Hand" Click="QuickRotateRight_Click" ToolTip="Xoay phải 90°" />
                                        <Button Content="🗑" Width="28" Height="22" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand" Click="QuickDelete_Click" ToolTip="Xóa trang" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding PageLabel}" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Name="StatusTextBlock" VerticalAlignment="Center" Foreground="#94A3B8" Text="Đang tải danh sách trang..." />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Hủy" Style="{StaticResource OrganizerButton}" Width="90" Margin="0,0,12,0" IsCancel="True" />
                    <Button Content="Lưu Thay Đổi" Style="{StaticResource PrimaryOrganizerButton}" Width="140" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
