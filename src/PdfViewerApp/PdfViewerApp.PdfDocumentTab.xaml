<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PdfViewerApp.PdfDocumentTab" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PdfViewerApp">
  <Control.Background>
    <SolidColorBrush Color="#0B0F19" />
  </Control.Background>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Name="SidebarColumn" Width="0" MinWidth="0" MaxWidth="400" />
      <ColumnDefinition Name="SplitterColumn" Width="0" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Name="SidebarBorder" Grid.Column="0" Background="#0F172A" Margin="10,10,0,10" CornerRadius="12" Visibility="Collapsed">
      <UIElement.Effect>
        <DropShadowEffect Color="#0F172A" Opacity="0.1" BlurRadius="12" ShadowDepth="2" Direction="270" />
      </UIElement.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Name="SidebarHeaderBorder" Background="#1E1B4B" CornerRadius="12,12,0,0" Padding="12">
          <DockPanel LastChildFill="False">
            <TextBlock Name="SidebarHeaderText" Text="TRANG THU NHỎ" FontWeight="Bold" Foreground="#FFFFFFFF" FontSize="12" DockPanel.Dock="Left" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,5,0,5">
          <StackPanel Margin="10">
            <StackPanel>
              <TextBlock Text="THUMBNAILS" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" Margin="2,0,0,8" />
              <StackPanel Name="ThumbnailContainer" />
            </StackPanel>
            <Border Height="1" Background="#1E293B" Margin="0,12,0,12" />
            <StackPanel>
              <DockPanel Margin="2,0,0,8">
                <TextBlock Text="RECENT PAGES" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <Button Name="BookmarkCurrentPageBtn" Content="Bookmark" DockPanel.Dock="Right" Padding="8,2" Margin="8,0,0,0" Click="BookmarkCurrentPage_Click" />
              </DockPanel>
              <StackPanel Name="RecentPagesContainer" />
            </StackPanel>
            <Border Height="1" Background="#1E293B" Margin="0,12,0,12" />
            <StackPanel>
              <DockPanel Margin="2,0,0,8">
                <TextBlock Text="BOOKMARKS" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <Button Name="ClearBookmarksBtn" Content="Clear" DockPanel.Dock="Right" Padding="8,2" Margin="8,0,0,0" Click="ClearBookmarks_Click" />
              </DockPanel>
              <StackPanel Name="BookmarksContainer" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#00FFFFFF" />
    <Border Name="CanvasBorder" Grid.Column="2" Background="#111827" Margin="10" CornerRadius="12">
      <UIElement.Effect>
        <DropShadowEffect Color="#0F172A" Opacity="0.12" BlurRadius="16" ShadowDepth="4" Direction="270" />
      </UIElement.Effect>
      <Grid>
        <TextBlock Name="EmptyStateText" Text="Đang tải PDF..." FontSize="18" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" FontWeight="Medium" />
        <ScrollViewer Name="DocumentScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <FrameworkElement.ContextMenu>
            <ContextMenu Name="DocContextMenu" Opened="DocContextMenu_Opened">
              <MenuItem Header="Dán" InputGestureText="Ctrl+V" Click="ContextPaste_Click" />
              <MenuItem Header="Dán tại chỗ" InputGestureText="Ctrl+Alt+V" Click="ContextPasteInPlace_Click" />
              <Separator />
              <MenuItem Name="MenuReadMode" Header="Chế độ đọc" InputGestureText="Ctrl+H" Click="ContextReadMode_Click" />
              <MenuItem Name="MenuFullScreen" Header="Toàn màn hình" InputGestureText="F11" Click="ContextFullScreen_Click" />
              <Separator />
              <MenuItem Header="Phóng to" InputGestureText="Ctrl++" Click="ContextZoomIn_Click" />
              <MenuItem Header="Thu nhỏ" InputGestureText="Ctrl+-" Click="ContextZoomOut_Click" />
              <Separator />
              <MenuItem Name="MenuActualSize" Header="Kích thước thực tế" InputGestureText="Ctrl+1" Click="ContextActualSize_Click" />
              <MenuItem Name="MenuFitPage" Header="Vừa khít trang" InputGestureText="Ctrl+0" Click="ContextFitPage_Click" />
              <MenuItem Name="MenuFitWidth" Header="Vừa khít chiều rộng" InputGestureText="Ctrl+2" Click="ContextFitWidth_Click" />
              <Separator />
              <MenuItem Header="Xoay phải" InputGestureText="Ctrl+Shift++" Click="ContextRotateRight_Click" />
              <MenuItem Name="MenuReverseView" Header="Xem đảo ngược" Click="ContextReverseView_Click" />
              <Separator />
              <MenuItem Header="In ấn" InputGestureText="Ctrl+P" Click="ContextPrint_Click" />
              <Separator />
              <MenuItem Name="MenuRulers" Header="Thước đo" InputGestureText="Ctrl+R" Click="ContextRulers_Click" />
              <MenuItem Name="MenuGuides" Header="Đường gióng" Click="ContextGuides_Click" />
              <Separator />
              <MenuItem Name="MenuHideNavigation" Header="Ẩn thanh điều hướng" InputGestureText="F4" Click="ContextHideNavigation_Click" />
            </ContextMenu>
          </FrameworkElement.ContextMenu>
          <Grid Name="PagesHost" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Top" />
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
