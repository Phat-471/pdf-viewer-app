<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PdfViewerApp.AboutDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Giới Thiệu PDF Pro Workspace" Width="640" Height="520" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#0F172A" Foreground="#F8FAFC" FontFamily="Segoe UI, Tahoma, Helvetica">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Border" CornerRadius="8" Padding="16,10">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F766E" Offset="0.0" />
                    <GradientStop Color="#06B6D4" Offset="1.0" />
                  </LinearGradientBrush>
                </Border.Background>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="UIElement.Opacity" Value="0.92" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Border" Property="UIElement.Opacity" Value="0.84" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#94A3B8" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Border" CornerRadius="8" BorderThickness="1.5" BorderBrush="#334155" Background="#00FFFFFF" Padding="14,8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Border" Property="Border.BorderBrush" Value="#475569" />
                  <Setter Property="Foreground" Value="#F8FAFC" />
                  <Setter TargetName="Border" Property="Border.Background" Value="#1E293B" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Border" Property="Border.Background" Value="#0F172A" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="InfoCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#111827" />
        <Setter Property="BorderBrush" Value="#1E293B" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,10,10" />
      </Style>
      <Style x:Key="InfoLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#38BDF8" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="InfoValueStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#F8FAFC" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="TagStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="#0B1220" />
        <Setter Property="BorderBrush" Value="#1E293B" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,0,8,0" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Panel.Background>
      <RadialGradientBrush Center="0.5,0" RadiusX="0.85" RadiusY="0.85">
        <GradientStop Color="#1E1B4B" Offset="0" />
        <GradientStop Color="#0F172A" Offset="1" />
      </RadialGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Height="4" VerticalAlignment="Top">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#0F766E" Offset="0.0" />
          <GradientStop Color="#06B6D4" Offset="0.5" />
          <GradientStop Color="#38BDF8" Offset="1.0" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Grid Grid.Row="1" Margin="24,24,24,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="18" Padding="18">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <Border Width="104" Height="104" CornerRadius="28" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,18">
            <Image Width="72" Height="72" Source="{StaticResource AppLogoImage}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="PDF Pro Workspace" FontSize="21" FontWeight="Black" Foreground="#F8FAFC" HorizontalAlignment="Center" TextAlignment="Center" />
          <TextBlock Text="Engineering PDF workspace" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Border Style="{StaticResource TagStyle}">
              <TextBlock Text="Merge" Foreground="#A5F3FC" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <Border Style="{StaticResource TagStyle}">
              <TextBlock Text="Annotate" Foreground="#FDE68A" FontSize="11" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Border Style="{StaticResource TagStyle}">
              <TextBlock Text="Print" Foreground="#86EFAC" FontSize="11" FontWeight="SemiBold" />
            </Border>
            <Border Style="{StaticResource TagStyle}">
              <TextBlock Text="Rollback" Foreground="#FDA4AF" FontSize="11" FontWeight="SemiBold" />
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="18,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Giới thiệu &amp; thông tin bản dựng" FontSize="24" FontWeight="Black" Foreground="#F8FAFC">
            <UIElement.Effect>
              <DropShadowEffect Color="#38BDF8" BlurRadius="8" Opacity="0.25" ShadowDepth="0" />
            </UIElement.Effect>
          </TextBlock>
          <TextBlock Text="Bản này tập trung vào workflow kỹ thuật: đọc PDF nhanh, chỉnh sửa page, annotation, in ấn, AI snapshot và rollback an toàn khi cập nhật." FontSize="13" Foreground="#94A3B8" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <UniformGrid Grid.Row="1" Columns="2" Margin="0,18,0,0">
          <Border Style="{StaticResource InfoCardStyle}">
            <StackPanel>
              <TextBlock Text="PHIÊN BẢN" Style="{StaticResource InfoLabelStyle}" />
              <TextBlock Name="VersionValueTextBlock" Text="v1.0.0" Style="{StaticResource InfoValueStyle}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource InfoCardStyle}">
            <StackPanel>
              <TextBlock Text="BẢN DỰNG" Style="{StaticResource InfoLabelStyle}" />
              <TextBlock Name="BuildValueTextBlock" Text="Release x64" Style="{StaticResource InfoValueStyle}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource InfoCardStyle}">
            <StackPanel>
              <TextBlock Text="TRẠNG THÁI BẢN QUYỀN" Style="{StaticResource InfoLabelStyle}" />
              <TextBlock Name="ActivationValueTextBlock" Text="Chưa kích hoạt" Style="{StaticResource InfoValueStyle}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource InfoCardStyle}">
            <StackPanel>
              <TextBlock Text="CORE PDF" Style="{StaticResource InfoLabelStyle}" />
              <TextBlock Name="CoreValueTextBlock" Text="pdf_core.dll | pdfium.dll" Style="{StaticResource InfoValueStyle}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </UniformGrid>
        <Border Grid.Row="2" Background="#111827" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="Mã máy" Style="{StaticResource InfoLabelStyle}" />
            <TextBlock Name="MachineIdValueTextBlock" Text="-" Style="{StaticResource InfoValueStyle}" FontFamily="Consolas" FontSize="13" Margin="0,4,0,0" />
          </StackPanel>
        </Border>
        <Border Grid.Row="3" Background="#0B1220" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,14,10,0">
          <StackPanel>
            <TextBlock Text="Hỗ trợ" Style="{StaticResource InfoLabelStyle}" />
            <TextBlock Text="Phiên bản này đã gắn logo mới, icon mới và luồng rollback để an toàn hơn khi cập nhật." Foreground="#CBD5E1" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,10" />
            <TextBlock Foreground="#94A3B8" FontSize="12">
              <Run Text="Website: " />
              <Hyperlink NavigateUri="https://hongmien.vn" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#38BDF8" TextDecorations="None">hongmien.vn</Hyperlink>
            </TextBlock>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="24,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Foreground="#64748B" FontSize="12">
          <Run Text="PDF Pro Workspace" />
          <Run Text=" · " />
          <Run Text="HPhat Edition" />
          <Run Text=" · " />
          <Run Text="Premium dark UI / engineering PDF workflow" />
        </TextBlock>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="Sao chép thông tin" Style="{StaticResource SecondaryButton}" Width="150" Margin="0,0,12,0" Click="CopyInfo_Click" />
          <Button Content="Đóng" Style="{StaticResource PrimaryButton}" Width="100" IsDefault="True" IsCancel="True" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
